  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "主人公たちは足早に万年牢獄を抜け、外へ飛び出した。",
      "voice": "",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "ロジカ",
      "text": "ここを通りたくば、この守護者、スフィンクス娘のロジカを倒して進むがよいぞ！",
      "voice": "ch_10098/Main/1112/1112_10098_128",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "クロミ",
      "text": "え、さっき戦いませんでしたっけ……？",
      "voice": "ch_10021/Main/1112/1112_10021_129",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "セレン",
      "text": "そして、私らが勝って、通してもらっただろ？",
      "voice": "ch_10023/Main/1112/1112_10023_130",
      "command": ""
    },
    {
      "row": 16,
      "speaker": "ロジカ",
      "text": "それは行きの話なり！\nこの先に封じられし、危険なモンスター娘を解放し、あまつさえ連れ帰ろうなどという暴挙、この守護者たる私が見て見ぬふりは出来ぬ。",
      "voice": "ch_10098/Main/1112/1112_10098_131",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "スズ",
      "text": "解放し、連れ帰る……？",
      "voice": "ch_10022/Main/1112/1112_10022_132",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "",
      "text": "スズが、ロジカの指さす先を振り返る……と。",
      "voice": "",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "ダムストー",
      "text": "あ、どうも。",
      "voice": "ch_10295/Main/1112/1112_10295_133",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "スズ",
      "text": "え！？　ダムストーさん、出てきちゃったんですか！？",
      "voice": "ch_10022/Main/1112/1112_10022_134",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "ダムストー",
      "text": "や……なんか、置いていかれるの寂しいなぁって。",
      "voice": "ch_10295/Main/1112/1112_10295_135",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "主人公",
      "text": "封印は！？\n封印はどうしたんですか！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "ダムストー",
      "text": "あ、通販で牢獄のカギが買えるので。",
      "voice": "ch_10295/Main/1112/1112_10295_136",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "スズ",
      "text": "ちょっと、フェルミさぁん！？",
      "voice": "ch_10022/Main/1112/1112_10022_137",
      "command": ""
    },
    {
      "row": 47,
      "speaker": "主人公",
      "text": "いや、フェルミさんは運んでるだけで、恐らく、荷の中身までは知らなかったのでは……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "スズ",
      "text": "ああ……まあ、そうよね……。",
      "voice": "ch_10022/Main/1112/1112_10022_138",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "ロジカ",
      "text": "という訳で、災厄を解き放つモノ、この守護者が止めるのである！！",
      "voice": "ch_10098/Main/1112/1112_10098_139",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "主人公",
      "text": "せ、戦闘ですか……やむを得ませんか……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "ダムストー",
      "text": "す、すみません、すみません。\n早速、災厄を皆さんにばらまいてしまい、すみませんっ！",
      "voice": "ch_10295/Main/1112/1112_10295_140",
      "command": ""
    }
  ]
}
