  "cache_bundle": "C:\\Users\\77147\\Documents\\Codex\\2026-08-21\\bang\\outputs\\MonsterMusumeTDMod\\解包资源\\ab\\７章_05話前半_1107051Nml.ab",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "道中、ブラックドラゴン娘たちとの戦闘に阻まれながらも、\n主人公たちはようやく樹氷宮殿に到着する。",
      "voice": "",
      "command": ""
    },
    {
      "row": 9,
      "speaker": "",
      "text": "そして、樹氷宮殿に\n陣取る『姫魔導士師団』のカティナに、\n彼らの置かれた状況とここに至る事情を説明した。",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "主人公",
      "text": "……という訳で、祠に眠る獣神を蘇らせないといけないんです。",
      "voice": "",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "カティナ",
      "text": "…………。",
      "voice": "en_40295/Main/1107/1107_40295_250",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "主人公",
      "text": "カティナさん……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 16,
      "speaker": "カティナ",
      "text": "あほじゃないの！？\nあほあほなんじゃないの！？",
      "voice": "en_40295/Main/1107/1107_40295_251",
      "command": ""
    },
    {
      "row": 17,
      "speaker": "主人公",
      "text": "あほあほ……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "カティナ",
      "text": "何が『いやらしい症候群』よ！\nもうちょっと真面目な嘘吐きなさいよ！",
      "voice": "en_40295/Main/1107/1107_40295_252",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "カティナ",
      "text": "アンタみたいな不器用な奴が、と思ってたけど、\nやっぱり、王国の誰かに頼まれてきたスパイなのね……！\n利用されているのなら、覚まさせてあげる、その目を！！",
      "voice": "en_40295/Main/1107/1107_40295_253",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "主人公",
      "text": "ち、ちが……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "カティナ",
      "text": "２番隊、ラシオネルを捕らえなさい！\nスパイ容疑よ！！",
      "voice": "en_40295/Main/1107/1107_40295_254",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "セレン",
      "text": "ご主人、こりゃ、無理だ、押し通るぞ！",
      "voice": "ch_10023/Main/1107/1107_10023_255",
      "command": ""
    },
    {
      "row": 28,
      "speaker": "ビビ神",
      "text": "いやらしい症候群はゲシュペンス島ぐらいにしか\n存在しないレアな風土病ですからね……。\n信じられないのも無理はありませんよ。",
      "voice": "ch_30005/Main/1107/1107_30005_256",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "クロミ",
      "text": "どうして、馬鹿正直に説明しようなんて\n思ったんですか、ご主人くん。",
      "voice": "ch_10021/Main/1107/1107_10021_257",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "主人公",
      "text": "クロミさんがやれって言ったんですよ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "クロミ",
      "text": "そんなことが……？",
      "voice": "ch_10021/Main/1107/1107_10021_258",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "スズ",
      "text": "クロミの言うことを真に受けた時点で、もう、ダメなのよ……。",
      "voice": "ch_10022/Main/1107/1107_10022_259",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "クロミ",
      "text": "えへへへぇ。",
      "voice": "ch_10021/Main/1107/1107_10021_260",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "セレン",
      "text": "誉めてねえ！！",
      "voice": "ch_10023/Main/1107/1107_10023_261",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "主人公",
      "text": "敵、来ます！\n全員、緊急戦闘用意！！",
      "voice": "",
      "command": ""
    }
  ]
}
