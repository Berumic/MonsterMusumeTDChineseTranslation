{
  "scenario_id": "1100012nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1100/1100012nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\6bc840f66524867560ac47fe8a39908ce4d878938488ef4b9324b339a936ee94\\6bc840f66524867560ac47fe8a39908c\\__data",
  "rows": [
    {
      "row": 9,
      "speaker": "ビビ神",
      "text": "何とか勝てましたね。\nご主人さまは、戦闘指示が的確でした。\n指揮をするのに向いているのかもしれませんね。",
      "voice": "ch_30005/Main/1100/1100_30005_034",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "ポデル",
      "text": "いやぁ、快勝快勝！\nすっげー気持ちよく戦えたぜ！　",
      "voice": "ch_10011/Main/1100/1100_10011_035",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "スズ",
      "text": "まるで血の繋がった姉弟みたいに、\n私とも息がぴったりだったね。\n本当に君は何者なの……？",
      "voice": "ch_10022/Main/1100/1100_10022_036",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "ビビ神",
      "text": "それは私が語りましょう――。",
      "voice": "ch_30005/Main/1100/1100_30005_037",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "",
      "text": "ビビ神は２人へこれまでの経緯を説明する。\n彼が浜辺に漂着していたこと、記憶喪失であること。\nこの世で生きる喜び、そして、悲しみのことを。",
      "voice": "",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "主人公",
      "text": "最後のいりました？",
      "voice": "",
      "command": ""
    },
    {
      "row": 29,
      "speaker": "ビビ神",
      "text": "――という訳で、彼のことは『ご主人様』的な\nニュアンスで呼んでください。",
      "voice": "ch_30005/Main/1100/1100_30005_038",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "主人公",
      "text": "そんな無茶苦茶な……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "ポデル",
      "text": "オレはポデルだ。",
      "voice": "ch_10011/Main/1100/1100_10011_039",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "ポデル",
      "text": "知り合いに騎士がいたら紹介してくれよな！",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "スズ",
      "text": "いや記憶喪失だって言ってたよね！？\n私はスズよ。",
      "voice": "ch_10022/Main/1100/1100_10022_040",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "スズ",
      "text": "よろしくね、ご主人くん。",
      "voice": "",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "主人公",
      "text": "２人とも適応早いですね！？\n……まぁ、こちらこそ、よろしくお願いします。",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "スズ",
      "text": "それで、ご主人くんはこれからどうするの？",
      "voice": "ch_10022/Main/1100/1100_10022_041",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "主人公",
      "text": "うーん、記憶を取り戻したいんですが……。\n正直どうすればいいかまったくわかりません。",
      "voice": "",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "スズ",
      "text": "なら、私たちと一緒に行かない？\n記憶喪失の君を放っておけないし、さっきみたいに\n指示を出してもらえれば私たちも助かるからさ。",
      "voice": "ch_10022/Main/1100/1100_10022_042",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "ポデル",
      "text": "もちろんオレは大歓迎だぜ。",
      "voice": "ch_10011/Main/1100/1100_10011_043",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "主人公",
      "text": "そうですね……じゃあ、お言葉に甘えて。",
      "voice": "",
      "command": ""
    },
    {
      "row": 47,
      "speaker": "スズ",
      "text": "やった！　そうと決まったら、さっそく出発しよう！\n道すがら状況を説明するね。",
      "voice": "ch_10022/Main/1100/1100_10022_044",
      "command": ""
    }
  ]
}
