{
  "scenario_id": "1100012nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1100/1100012nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\6bc840f66524867560ac47fe8a39908ce4d878938488ef4b9324b339a936ee94\\6bc840f66524867560ac47fe8a39908c\\__data",
  "rows": [
    {
      "row": 9,
      "speaker": "薇薇神",
      "text": "好歹是赢下来了呀。\n主人您的战斗指令十分精准。\n说不准，您还挺适合指挥大局的呢。",
      "voice": "ch_30005/Main/1100/1100_30005_034",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "波德鲁",
      "text": "哎呀呀，大获全胜大获全胜！\n打得那叫一个痛快啊！",
      "voice": "ch_10011/Main/1100/1100_10011_035",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "铃",
      "text": "简直就像血脉相连的姐弟一样，\n和我配合得严丝合缝呢。\n你究竟是什么来头啊……？",
      "voice": "ch_10022/Main/1100/1100_10022_036",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "薇薇神",
      "text": "那件事，便由我来讲述吧――。",
      "voice": "ch_30005/Main/1100/1100_30005_037",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "",
      "text": "薇薇神向两人讲起了此前的来龙去脉。\n他漂流到海滩的缘由、以及丧失记忆一事。\n还有，活在这世上的喜悦，以及，悲伤。",
      "voice": "",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "主人公",
      "text": "最后那些也有必要说吗？",
      "voice": "",
      "command": ""
    },
    {
      "row": 29,
      "speaker": "薇薇神",
      "text": "――总之呢，请二位以『主人』这样的\n或者类似的称呼来称呼他。",
      "voice": "ch_30005/Main/1100/1100_30005_038",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "主人公",
      "text": "这也太胡来了……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "波德鲁",
      "text": "我是波德鲁。",
      "voice": "ch_10011/Main/1100/1100_10011_039",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "波德鲁",
      "text": "你要是认识骑士，可得介绍给老子啊！",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "铃",
      "text": "不是说了他失忆了嘛！？\n我是铃哦。",
      "voice": "ch_10022/Main/1100/1100_10022_040",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "铃",
      "text": "请多指教啦，主人君。",
      "voice": "",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "主人公",
      "text": "你们俩也太快入戏了吧！？\n……不过，我才要请二位多关照了。",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "铃",
      "text": "那么，主人君接下来打算怎么办呢？",
      "voice": "ch_10022/Main/1100/1100_10022_041",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "主人公",
      "text": "唔——，我是想找回记忆的……。\n可说真的，压根不知道该从哪儿下手。",
      "voice": "",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "铃",
      "text": "那，要不要跟我们一起走？\n总不能把失忆的你丢下不管，而且像刚才那样\n有你帮我们发号施令，我们也省心嘛。",
      "voice": "ch_10022/Main/1100/1100_10022_042",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "波德鲁",
      "text": "我当然是举双手欢迎啊。",
      "voice": "ch_10011/Main/1100/1100_10011_043",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "主人公",
      "text": "说得也是……那，我就恭敬不如从命了。",
      "voice": "",
      "command": ""
    },
    {
      "row": 47,
      "speaker": "铃",
      "text": "太好了！　决定了就赶紧出发吧！\n路上我再跟你说明情况哦。",
      "voice": "ch_10022/Main/1100/1100_10022_044",
      "command": ""
    }
  ]
}