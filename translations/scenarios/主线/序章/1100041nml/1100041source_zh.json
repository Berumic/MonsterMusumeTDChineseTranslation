{
  "scenario_id": "1100041nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1100/1100041nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\53afe0fbaa322d2f714ba9a3edec2403a49dd312b22e3d86172a3114f3565db3\\53afe0fbaa322d2f714ba9a3edec2403\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "主人公摇摇晃晃地走在海岸上，\n回到了魔物娘们的身边。\n一旁，光泽更盛的琳（本公司120％标准）正心满意足地笑着。",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "琳",
      "text": "好开心～。下次再一起玩哦，主人！",
      "voice": "ch_10006/Main/1100/1100_10006_097",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "主人公",
      "text": "呜呜……要是这种地方被谁看见了……啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "萨拉",
      "text": "哎呀哎呀，主人虽说是在休息，\n但看来需要的却是另一种休息呢。\n毕竟精神头儿好像过剩了吧？",
      "voice": "ch_10057/Main/1100/1100_10057_098",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "铃",
      "text": "你、你你你、你、你做了什么！？\n难不成是你俩独处……难道说！？",
      "voice": "ch_10022/Main/1100/1100_10022_099",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "波德鲁",
      "text": "喂喂，你俩偷偷幽会也太狡猾了！\n把老子也带上呀！",
      "voice": "ch_10011/Main/1100/1100_10011_100",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "琳",
      "text": "诶嘿嘿～，我先走一步啦～♪\n因为主人是我的未婚夫嘛♪",
      "voice": "ch_10006/Main/1100/1100_10006_101",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "主人公",
      "text": "都说了不是啦……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "波德鲁",
      "text": "好啦好啦，未婚夫什么的就别在意啦！\n主人不是骑士这点，我也先不计较了！",
      "voice": "ch_10011/Main/1100/1100_10011_102",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "主人公",
      "text": "那点才该计较吧！？\n……等等，别、别凑过来呀！\n呀，你摸哪儿……哇啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "",
      "text": "魔物娘们将身形娇小的主人公团团围住。\n一场扭曲欲望相互碰撞的大乱斗，\n一场并非『骨肉』相争、而是『肉肉』相搏的纷争，正要拉开帷幕——",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "",
      "text": "就在此时。",
      "voice": "",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "偷猎者",
      "text": "在这边！　找到魔物娘了，给我抓住她们！",
      "voice": "",
      "command": ""
    },
    {
      "row": 93,
      "speaker": "薇薇神",
      "text": "好啦好啦，各位，敌袭来了哦。\n来，快把内裤穿上吧，主人。",
      "voice": "ch_30005/Main/1100/1100_30005_103",
      "command": ""
    },
    {
      "row": 94,
      "speaker": "主人公",
      "text": "我还穿着呢！？",
      "voice": "",
      "command": ""
    }
  ]
}