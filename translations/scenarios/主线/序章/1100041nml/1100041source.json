{
  "scenario_id": "1100041nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1100/1100041nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\53afe0fbaa322d2f714ba9a3edec2403a49dd312b22e3d86172a3114f3565db3\\53afe0fbaa322d2f714ba9a3edec2403\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "主人公はふらふらと海岸を歩き、\nモンスター娘たちのもとへと戻っていた。\n隣ではツヤの増したリン（当社比120％）が満足げに笑っている。",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "リン",
      "text": "楽しかった～。また遊ぼうね、ご主人くん！",
      "voice": "ch_10006/Main/1100/1100_10006_097",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "主人公",
      "text": "ぅぅ……こんなところを誰かに見られたら……ハッ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "サウラ",
      "text": "あらあら、ご主人くんには、休憩は休憩でも、\n別の休憩が必要だったみたいねぇ。\n元気が有り余っているみたいだし？",
      "voice": "ch_10057/Main/1100/1100_10057_098",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "スズ",
      "text": "なっ、なななっ、ななっ、なにしてたの！？\nまさか２人きりってことは……まさかなの！？",
      "voice": "ch_10022/Main/1100/1100_10022_099",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "ポデル",
      "text": "おいおい、２人でしけこむなんてズリィぞ！\nオレも混ぜろよっ！",
      "voice": "ch_10011/Main/1100/1100_10011_100",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "リン",
      "text": "えへへ～、お先に～♪\nだってご主人くんは、わたしの婚約者だもん♪",
      "voice": "ch_10006/Main/1100/1100_10006_101",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "主人公",
      "text": "だから違うって……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "ポデル",
      "text": "まぁまぁ、婚約者とか細かいことは気にすんな！\nオレもご主人が騎士じゃない点については\nいったん気にしねーからさ！",
      "voice": "ch_10011/Main/1100/1100_10011_102",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "主人公",
      "text": "そこは気にするべきでは！？\n……って、ちょっと、詰め寄ってこないでください！\nひゃっ、どこ触って……うわぁ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "",
      "text": "モンスター娘たちが小柄な主人公を取り囲んだ。\n歪んだ性欲がぶつかり合う大乱闘、\n骨肉ならぬ肉肉の争いが幕を開けようとした――",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "",
      "text": "その時。",
      "voice": "",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "密猟者",
      "text": "こっちだ！　モンスター娘を見つけたぞ、ひっつかまえろ！",
      "voice": "",
      "command": ""
    },
    {
      "row": 93,
      "speaker": "ビビ神",
      "text": "はいはい、皆さん敵襲ですよ。\nほら、早くパンツを履いてくださいね、ご主人さま。",
      "voice": "ch_30005/Main/1100/1100_30005_103",
      "command": ""
    },
    {
      "row": 94,
      "speaker": "主人公",
      "text": "履いてますよ！？",
      "voice": "",
      "command": ""
    }
  ]
}
