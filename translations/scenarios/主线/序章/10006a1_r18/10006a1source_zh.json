{
  "scenario_id": "10006a1_r18",
  "asset_path": "assets/advscene/scenarioexcel/character/10006/10006a1_r18.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\5bebc57207bad01438e525cce4853a6b891be33f97a25e2d0b846392cfc6cb1b\\5bebc57207bad01438e525cce4853a6b\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "琳",
      "text": "又不行吗……。\n果然，光是走马灯刺激还不够呢？",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_013",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "琳",
      "text": "嗯～……那么，这样如何？\n你看，主人的这里……好像变得很有精神呢。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_014",
      "command": ""
    },
    {
      "row": 9,
      "speaker": "",
      "text": "话音未落，琳小姐便将一部分头发液化，\n灵巧地把我的双腿分开。",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "",
      "text": "就这样，琳小姐将身体滑进我的双腿之间，\n用半透明的乳房夹住了那早已昂首挺立的分身。",
      "voice": "",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "琳",
      "text": "要是这样做的话，被我的胸伺候得舒服的\n主人，说不定会借着泄出来时的冲击\n想起些什么呢。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_015",
      "command": ""
    },
    {
      "row": 21,
      "speaker": "",
      "text": "整个性器被光滑而冰凉的触感包裹，\n我不禁因这陌生的感觉轻轻叫出声来。",
      "voice": "",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "琳",
      "text": "主人喜欢哪一种呢？\n是摩擦？　还是说……像这样捏来捏去？",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_016",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "",
      "text": "分身被反复揉捏刺激之后，\n富有弹性的触感与冰凉滑腻的触感交织在一起，\n难以估量的快感涌了上来。",
      "voice": "",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "琳",
      "text": "这样很舒服吧，主人♪\n嗯、呼、嗯嗯，你看，只是稍微摩擦一下，\n小鸡鸡就变大起来了哦……嗯、嗯。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_017",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "主人公",
      "text": "嗯、唔……嗯嗯。",
      "voice": "",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "琳",
      "text": "不许忍着声音哦。\n尽管发出好多好多可爱的声音也没关系啦♪",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_018",
      "command": ""
    },
    {
      "row": 28,
      "speaker": "",
      "text": "琳小姐像是在炫耀似的将双乳靠拢。\n每当那甜美的酥麻从变得敏感的分身窜过、\n几乎让腰都软掉时，我都拼命忍住险些漏出的娇声。",
      "voice": "",
      "command": ""
    },
    {
      "row": 29,
      "speaker": "琳",
      "text": "……真是的，拿你没办法。\n对这么倔强的主人，\n我就让你舒服到连声音都忍不住吧～♪",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_019",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "",
      "text": "分身被加重力道套弄，\n几乎要溺毙的强烈快感浪潮涌来，\n我不由得叫出了声。",
      "voice": "",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "琳",
      "text": "哼哼，出声了呢。\n而且呀……嗯嗯，你看，\n小鸡鸡的前端溢出什么来了哦？",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_020",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "琳",
      "text": "这个，要是吸上去会是什么感觉呢？\n嗯嗯、啾……啾噜、嗯哈啊……啾噜噜。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_021",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "",
      "text": "从半透明乳房的缝隙间探出的龟头被吸住，\n宛如电流般的酥麻沿着背脊窜过。",
      "voice": "",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "琳",
      "text": "嗯、啾、啾噜、嗯、哈啊……。\n唔～嗯，味道有点不可思议……。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_022",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "琳",
      "text": "不过，好像有点上瘾了呢……哼哼。\n我会再、再多吸一点的。\n嗯啾、啾噜、啾噜噜……啾呜呜！",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_023",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "",
      "text": "被更加用力吸吮所带来的刺激\n传向下腹，分身的前端溢出了先走液。",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "琳",
      "text": "嗯嗯……啾噜、嗯、哈啊……。\n哇，溢出好多来了哦？\n这就是舒服的证据的汁液吧。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_024",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "",
      "text": "伴着淫靡黏腻的水声，\n琳小姐开始更用力地套弄分身，\n还刻意地用舌头爬过龟头顶端，来回舔舐。",
      "voice": "",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "琳",
      "text": "咧啰、啾噜、啾噜噜、\n嗯、呼、滋噜、啾噜噜！",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_025",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "",
      "text": "淫靡的水声回荡着，被黏液质乳房舔弄的分身，\n确实地在膨胀，静候着抵达绝顶的时刻。",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "琳",
      "text": "嗯嗯、啾呜、咧啰、啾、啾啾……啾呜！！\n哼哼，已经快泄出来了吗？　可以哦，随时都可以来……！",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_026",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "琳",
      "text": "呣、嗯、啾呣、哈呣、嗯、咧啰、\n哈、呼、呼、啾噜、\n嗯，把主人的泄出来吧……啾噜噜噜！",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_027",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "",
      "text": "仿佛被格外强烈的吸吮催促着，\n膨胀的分身前端一口气释放出了热流。",
      "voice": "",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "主人公",
      "text": "嗯啊啊啊———！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "",
      "text": "仿佛有什么啪地炸裂开来，\n眼前一片空白的同时，\n我朝着琳小姐的身体射精了。",
      "voice": "",
      "command": ""
    },
    {
      "row": 47,
      "speaker": "琳",
      "text": "嗯嗯、呣呜……嗯嗯～～～！！\n嗯、唔、嗯……噗哈……哈、啊、哈啊……嗯",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_028",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "",
      "text": "在露出陶醉表情的琳小姐脸上与胸前，\n散布着我射出的精液。",
      "voice": "",
      "command": ""
    },
    {
      "row": 59,
      "speaker": "琳",
      "text": "哼哼哼……射了好多呢。\n洒掉了多可惜，\n我就全部咕咚咽下去吧。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_029",
      "command": ""
    },
    {
      "row": 60,
      "speaker": "",
      "text": "仿佛在吞咽一般，白浊的精液\n被吸进了那美丽剔透的水蓝色体内。",
      "voice": "",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "琳",
      "text": "哼哼……像这样将彼此的体液交融在一起，\n是史莱姆的求爱行为之一哦。\n这样一来，你总该想起来了吧，主人♪",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_030",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "主人公",
      "text": "欸！？　你在说……什么呀？",
      "voice": "",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "琳",
      "text": "咦……真奇怪呀？\n竟然还是想不起来……果然是刺激不够吧。",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_031",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "琳",
      "text": "那么……直到你好好想起来为止，\n不管多少次，我都得让你泄出来才行呢♪",
      "voice": "ch_10006/R18/10006A1_10006_R18/10006A0_10006_032",
      "command": ""
    },
    {
      "row": 65,
      "speaker": "",
      "text": "对着软绵绵地失了力气的分身，\n琳小姐再次将柔软的乳房贴了上来。",
      "voice": "",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "主人公",
      "text": "等、等一下——啊呜！",
      "voice": "",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "",
      "text": "刚刚登顶而浑身酥软的身体，\n根本不可能做出像样的抵抗。",
      "voice": "",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "",
      "text": "我静静地坠入了那滑腻与弹嫩交织的、\n快乐的世界之中。",
      "voice": "",
      "command": ""
    }
  ]
}