{
  "scenario_id": "1100072nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1100/1100072nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\69aba6b9f6f254a8a824218ad5c1444ad85c0ed23918553155591ce0b78c8405\\69aba6b9f6f254a8a824218ad5c1444a\\__data",
  "rows": [
    {
      "row": 9,
      "speaker": "梅吉",
      "text": "这些家伙好强！　艾洛依兹大人，咱们撤吧！",
      "voice": "en_40113/Main/1100/1100_40113_207",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "艾洛依兹",
      "text": "卡蜜拉还在对面呢！？",
      "voice": "en_40112/Main/1100/1100_40112_208",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "卡蜜拉",
      "text": "不，别管我，你们两个快逃吧！",
      "voice": "en_40114/Main/1100/1100_40114_209",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "艾洛依兹",
      "text": "哦，也是。那剩下的就交给你了！",
      "voice": "en_40112/Main/1100/1100_40112_210",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "梅吉",
      "text": "祝您保重啦！",
      "voice": "en_40113/Main/1100/1100_40113_211",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "",
      "text": "两人如脱兔般离去了。\n那脚步，真是说不出的轻快潇洒。",
      "voice": "",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "卡蜜拉",
      "text": "咦，那个……。",
      "voice": "en_40114/Main/1100/1100_40114_212",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "萨拉",
      "text": "真是薄情的同伙呢。连我都有点同情了。",
      "voice": "ch_10057/Main/1100/1100_10057_213",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "铃",
      "text": "虽然只剩你一个人了，还打算抵抗吗？",
      "voice": "ch_10022/Main/1100/1100_10022_214",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "卡蜜拉",
      "text": "……不，我认命了，愿受制裁。",
      "voice": "en_40114/Main/1100/1100_40114_215",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "波德鲁",
      "text": "啊？　你还挺老实的嘛。",
      "voice": "ch_10011/Main/1100/1100_10011_216",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "卡蜜拉",
      "text": "我原本就反对偷猎。\n是为了阻止那两个青梅竹马才跟来的，\n可惜我有心无力……。",
      "voice": "en_40114/Main/1100/1100_40114_217",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "卡蜜拉",
      "text": "（看来只能摆出温顺的态度来博取好感了……！）",
      "voice": "en_40114/Main/1100/1100_40114_218",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "琳",
      "text": "可是，刚才你还跟那两个人一起战斗了吧～？",
      "voice": "ch_10006/Main/1100/1100_10006_219",
      "command": ""
    },
    {
      "row": 49,
      "speaker": "铃",
      "text": "确实。",
      "voice": "ch_10022/Main/1100/1100_10022_220",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "卡蜜拉",
      "text": "即、即便是踏上了邪恶之路，\n我也无法眼睁睁看着朋友受伤……。",
      "voice": "en_40114/Main/1100/1100_40114_221",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "卡蜜拉",
      "text": "（嘛，虽然我每次都厚脸皮地拿走自己那份奖赏，\n就这么稀里糊涂地一直跟着，\n不过这份心情倒也不假就是了……）",
      "voice": "en_40114/Main/1100/1100_40114_222",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "铃",
      "text": "嗯——，伤脑筋呢。\n看起来像在说谎，又好像没在说谎……。\n主人君，这个人要怎么办？",
      "voice": "ch_10022/Main/1100/1100_10022_223",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "主人公",
      "text": "说的是呢……。\n如果她有反省，放她回去也无妨吧。",
      "voice": "",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "卡蜜拉",
      "text": "（太好了！　感谢您，神啊！）",
      "voice": "en_40114/Main/1100/1100_40114_224",
      "command": ""
    },
    {
      "row": 65,
      "speaker": "薇薇神",
      "text": "不，请稍等。\n如果一句抱歉就能了事，那还要警察做什么。\n我们要从那人身上收取〈辅助技能〉。",
      "voice": "ch_30005/Main/1100/1100_30005_225",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "卡蜜拉",
      "text": "…………咦？",
      "voice": "en_40114/Main/1100/1100_40114_226",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "主人公",
      "text": "〈辅助技能〉？",
      "voice": "",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "琳",
      "text": "是一段时间内随便使用的那个吧！",
      "voice": "ch_10006/Main/1100/1100_10006_227",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "克萝米",
      "text": "一段时间内想做就做！？　好涩情啊！\n是色色服务吧！",
      "voice": "ch_10021/Main/1100/1100_10021_228",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "铃",
      "text": "不对，是随便使用啦。\n而且那不是〈辅助技能〉，是会员订阅。",
      "voice": "ch_10022/Main/1100/1100_10022_229",
      "command": ""
    },
    {
      "row": 81,
      "speaker": "薇薇神",
      "text": "〈辅助技能〉，是从人类身上抽取的特别力量。\n给予魔物娘之后，\n便能扩张其可能性。",
      "voice": "ch_30005/Main/1100/1100_30005_230",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "克萝米",
      "text": "扩张这个词，听着也好涩情啊！",
      "voice": "ch_10021/Main/1100/1100_10021_231",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "铃",
      "text": "克萝米你还是先安静一会儿吧。",
      "voice": "ch_10022/Main/1100/1100_10022_232",
      "command": ""
    },
    {
      "row": 91,
      "speaker": "主人公",
      "text": "那么，要从这个人身上取出〈辅助技能〉吗？\n要怎么做？",
      "voice": "",
      "command": ""
    },
    {
      "row": 121,
      "speaker": "薇薇神",
      "text": "简而言之，就是『惩罚』。\n因为需要通过肉体接触来撬开灵魂。\n就是那种，黏黏糊糊、湿湿滑滑、一沉到底、缠绵不已的那种。",
      "voice": "ch_30005/Main/1100/1100_30005_233",
      "command": ""
    },
    {
      "row": 124,
      "speaker": "卡蜜拉",
      "text": "诶、等一下，那难道是……\n好、好、好下流的事情吗……。",
      "voice": "en_40114/Main/1100/1100_40114_234",
      "command": ""
    },
    {
      "row": 155,
      "speaker": "薇薇神",
      "text": "答得好。",
      "voice": "ch_30005/Main/1100/1100_30005_235",
      "command": ""
    },
    {
      "row": 158,
      "speaker": "卡蜜拉",
      "text": "神啊呜呜呜！？",
      "voice": "en_40114/Main/1100/1100_40114_236",
      "command": ""
    },
    {
      "row": 161,
      "speaker": "薇薇神",
      "text": "那么，琳。\n毕竟在主人的面前做也怪不好意思的，\n就到那边去吧。",
      "voice": "ch_30005/Main/1100/1100_30005_237",
      "command": ""
    },
    {
      "row": 192,
      "speaker": "琳",
      "text": "嗯！　虽然不太明白，不过我们上吧！",
      "voice": "ch_10006/Main/1100/1100_10006_238",
      "command": ""
    }
  ]
}