{
  "scenario_id": "10006a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10006/10006a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\47e6e5c5c8f2e45ffbf2838958468c7bf2455eadedeed8c99c0e1bc3793d382d\\47e6e5c5c8f2e45ffbf2838958468c7b\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "我在小屋附近的草丛后方便完，\n却被琳小姐撞见了现场，\n怀着满心的羞耻回到了屋内。",
      "voice": "",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "琳",
      "text": "呐？　为什么要藏起来呀？\n像从前那样，全部让我看也没关系哦？\n我们可是一起在史莱姆泳池玩过的交情呢。",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_001",
      "command": ""
    },
    {
      "row": 9,
      "speaker": "主人公",
      "text": "哇啊啊！　请把刚才看到的忘掉吧！\n我、我也会忘掉的……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "琳",
      "text": "明明主人和我是那种关系，\n为什么要那么害羞呀。\n来嘛，全部脱掉让我看看嘛～。",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_002",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "",
      "text": "琳小姐摇晃着我的身体，手伸向我的下半身。\n我羞得脸上几乎要喷出火来，\n却仍拼命用双手阻拦着。",
      "voice": "",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "琳",
      "text": "嗯～真是的……明明从小就互相啪呼啪呼的交情，\n连那个也忘了吗？\n来，就像这样……嘿～呀♪",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_003",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "",
      "text": "就那样任由琳小姐的势头摆布，\n我被当场推倒在地。",
      "voice": "",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "",
      "text": "下一瞬间，某种紧实而富有弹性的东西，\n将我的脸整个覆盖住了。",
      "voice": "",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "主人公",
      "text": "（是什么呢……这个，\n凉凉的、软软的，好舒服……）",
      "voice": "",
      "command": ""
    },
    {
      "row": 29,
      "speaker": "琳",
      "text": "看，就像这样把我的胸夹在你的脸上，\n变得滑溜溜地一起玩过吧？",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_004",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "主人公",
      "text": "——呣呜！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "",
      "text": "猛地回过神来，我的视野已是一片蔚蓝。\n准确地说，是我的脸被琳小姐的胸压得变了形。",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "主人公",
      "text": "（不、不能呼吸了——！！）",
      "voice": "",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "琳",
      "text": "嗯～？　怎么了呀，主人……挣扎得好厉害。\n啊，这样啊。时隔这么久又能被我的胸\n啪呼啪呼，就这么开心呀♪",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_005",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "主人公",
      "text": "唔嘎、唔嘎……！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "",
      "text": "被琳小姐用胸压得更紧，\n缺氧的我感到意识正一点点远去。",
      "voice": "",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "琳",
      "text": "咦，主人……？　睡着了吗？\n真是的，就算我的胸让人如坠梦境，\n这样也适得其反呀。来，打起精神。",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_006",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "主人公",
      "text": "——……噗哈啊！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "",
      "text": "终于从琳小姐胸部的压迫中挣脱的我，\n将新鲜空气深深吸进整个肺里。",
      "voice": "",
      "command": ""
    },
    {
      "row": 54,
      "speaker": "琳",
      "text": "早上好呀，主人♪\n怎么了吗，你的脸好红哦？",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_007",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "主人公",
      "text": "我、我还以为要死了……！！\n感觉就像过去的记忆一口气苏醒过来……！\n难道说，那就是走马灯……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 84,
      "speaker": "琳",
      "text": "诶嘿，太好了♪\n你终于想起来，\n你就是我失散的青梅竹马了呢。",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_008",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "主人公",
      "text": "不，不是的。那只是走马灯罢了。\n我从相遇起就一直在说，\n我并不是琳小姐那位青梅竹马的史莱姆。",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "琳",
      "text": "唔……不对，\n主人就是我的青梅竹马、未婚夫诗莱姆呀！\n说了没错，就是没错嘛。",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_009",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "",
      "text": "琳小姐像是闹别扭似的鼓起脸颊，极力主张着。\n无论我怎么否认，\n琳小姐都像着了魔一般坚信我是史莱姆进化后的样子。",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "琳",
      "text": "如果主人无论如何\n都找不回还是史莱姆时的记忆，\n那我就想方设法帮你回想起来……！",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_010",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "琳",
      "text": "刚才那个，走马灯……是这么说的吧？\n要是再来一次同样的事，记忆说不定就会回来啦♪",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_011",
      "command": ""
    },
    {
      "row": 90,
      "speaker": "主人公",
      "text": "诶，等……等一——！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 91,
      "speaker": "琳",
      "text": "那么，我要来咯～主人♪\n嘿——呀、姆啾！",
      "voice": "ch_10006/R18/10006A0_10006_Nml/10006A0_10006_012",
      "command": ""
    },
    {
      "row": 100,
      "speaker": "",
      "text": "我就这样被以排山倒海之势\n压住了脸的琳小姐，\n再一次体验到了走马灯。",
      "voice": "",
      "command": ""
    }
  ]
}