{
  "scenario_id": "1100061nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1100/1100061nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\7b719bcd41477539efd33b01c863ea139754f8d54e8646096c0d845549a3ece8\\7b719bcd41477539efd33b01c863ea13\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "？？？",
      "text": "呀啊啊啊啊啊啊啊！！",
      "voice": "ch_10021/Main/1100/1100_10021_128",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "铃",
      "text": "这是克萝米的声音！　来不及了吗！？",
      "voice": "ch_10022/Main/1100/1100_10022_129",
      "command": ""
    },
    {
      "row": 21,
      "speaker": "主人公",
      "text": "一定还来得及！　快走吧！",
      "voice": "",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "薇薇神",
      "text": "找到了！　倒在那边的就是魅魔娘呢。\n而且……。",
      "voice": "ch_30005/Main/1100/1100_30005_130",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "",
      "text": "说到这里，薇薇神的神色变得凝重起来。\n在她视线的尽头，站着一位看似偷猎者头目的人物。",
      "voice": "",
      "command": ""
    },
    {
      "row": 49,
      "speaker": "艾洛依兹",
      "text": "啊嗯？　魔物娘和……人类？",
      "voice": "en_40112/Main/1100/1100_40112_131",
      "command": ""
    },
    {
      "row": 50,
      "speaker": "波德鲁",
      "text": "拿着剑……这么说，那家伙就是艾洛依兹啊。",
      "voice": "ch_10011/Main/1100/1100_10011_132",
      "command": ""
    },
    {
      "row": 51,
      "speaker": "主人公",
      "text": "请放了那孩子！　偷猎是不对的！",
      "voice": "",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "艾洛依兹",
      "text": "哎呀，好个美少年！",
      "voice": "en_40112/Main/1100/1100_40112_133",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "艾洛依兹",
      "text": "……不对，你谁啊？",
      "voice": "",
      "command": ""
    },
    {
      "row": 54,
      "speaker": "琳",
      "text": "是我的未婚夫诗莱姆哦！",
      "voice": "ch_10006/Main/1100/1100_10006_134",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "艾洛依兹",
      "text": "原来如此，未婚夫啊。",
      "voice": "en_40112/Main/1100/1100_40112_135",
      "command": ""
    },
    {
      "row": 56,
      "speaker": "主人公",
      "text": "不是的。",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "艾洛依兹",
      "text": "什么意思！？",
      "voice": "en_40112/Main/1100/1100_40112_136",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "波德鲁",
      "text": "在谈完之前，你先安静一会儿吧。",
      "voice": "ch_10011/Main/1100/1100_10011_137",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "琳",
      "text": "噗～～。",
      "voice": "ch_10006/Main/1100/1100_10006_138",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "艾洛依兹",
      "text": "啊——算了，你是谁都无所谓了。\n为什么偷猎就不行呢。来，说说理由？",
      "voice": "en_40112/Main/1100/1100_40112_139",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "主人公",
      "text": "什么叫为什么，强行掳走他人、\n剥夺其自由的权利，谁都没有。\n请站在对方的立场上想一想！",
      "voice": "",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "艾洛依兹",
      "text": "啊——……嗯，是呢。确实够呛。\n换作是我的话，会又难受又悲伤又不甘心吧……。",
      "voice": "en_40112/Main/1100/1100_40112_140",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "艾洛依兹",
      "text": "不——过，我可不是魔物娘，\n不是被猎的一方，而是狩猎的一方啊！\n啊哈哈哈哈哈哈！",
      "voice": "en_40112/Main/1100/1100_40112_141",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "波德鲁",
      "text": "这家伙，看着挺开心的啊。",
      "voice": "ch_10011/Main/1100/1100_10011_142",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "薇薇神",
      "text": "简直就是画里走出来的恶人呢。",
      "voice": "ch_30005/Main/1100/1100_30005_143",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "主人公",
      "text": "可恶……你无论如何都不打算放弃吗？",
      "voice": "",
      "command": ""
    },
    {
      "row": 79,
      "speaker": "艾洛依兹",
      "text": "那是当然的啦！\n好啦，该你们上场了，小的们！\n把他们揍个稀巴烂！",
      "voice": "en_40112/Main/1100/1100_40112_144",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "主人公",
      "text": "不知不觉聚集了好多的人啊！",
      "voice": "",
      "command": ""
    },
    {
      "row": 109,
      "speaker": "铃",
      "text": "哇哇，怎么办……！",
      "voice": "ch_10022/Main/1100/1100_10022_145",
      "command": ""
    },
    {
      "row": 113,
      "speaker": "薇薇神",
      "text": "不，无需慌张。",
      "voice": "ch_30005/Main/1100/1100_30005_146",
      "command": ""
    },
    {
      "row": 114,
      "speaker": "主人公",
      "text": "自助餐小姐！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 115,
      "speaker": "薇薇神",
      "text": "是薇薇帕蒂。\n话说回来，终于到了我要解放力量的时候了呢。\n来，上吧，主人！",
      "voice": "ch_30005/Main/1100/1100_30005_147",
      "command": ""
    }
  ]
}