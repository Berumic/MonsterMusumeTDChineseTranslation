{
  "scenario_id": "1101081nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1101/1101081nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\8e1afaa054d67abf0570446458dbcde470254cd7d3d884636bdf49ef8c5eac44\\8e1afaa054d67abf0570446458dbcde4\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "主人公",
      "text": "这里先撤退吧。反正迟早要反攻，\n现在不是硬撑的时候。",
      "voice": "",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "赛莲",
      "text": "呼……你的指挥也变高明了呢，主人。\n今天指挥我尤其比上次好。",
      "voice": "ch_10023/Main/1101/1101_10023_244",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "特鲁鲁",
      "text": "什么呀汪，那副『后方男友』的嘴脸？",
      "voice": "ch_10027/Main/1101/1101_10027_245",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "弗兰茜",
      "text": "话说回来，明明今天才第一次被你指挥，上次是什么时候的事？\n还有，别站在那么远的地方，\n直接说不就好了吗。",
      "voice": "ch_10014/Main/1101/1101_10014_246",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "赛莲",
      "text": "啊！？　你是笨蛋吗！\n那种事多难为情呀……。",
      "voice": "ch_10023/Main/1101/1101_10023_247",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "弗兰茜",
      "text": "还『呀』呢。",
      "voice": "ch_10014/Main/1101/1101_10014_248",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "铃",
      "text": "那、那些先不提，现在得先逃啊！\n追兵会重整部队再杀过来的！",
      "voice": "ch_10022/Main/1101/1101_10022_249",
      "command": ""
    },
    {
      "row": 56,
      "speaker": "克萝米",
      "text": "说得对呢，快逃吧！　我知道有一间树屋，\n感觉很适合做些下流的事，\n主人就和我一起去那里吧。",
      "voice": "ch_10021/Main/1101/1101_10021_250",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "赛莲",
      "text": "你才危险吧！！",
      "voice": "ch_10023/Main/1101/1101_10023_251",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "克萝米",
      "text": "没事的没事的，主人。\n我什么都不会做，就只是前端，只是前端而已！",
      "voice": "ch_10021/Main/1101/1101_10021_252",
      "command": ""
    },
    {
      "row": 59,
      "speaker": "铃",
      "text": "什么的『前端』！？",
      "voice": "ch_10022/Main/1101/1101_10022_253",
      "command": ""
    },
    {
      "row": 60,
      "speaker": "克萝米",
      "text": "那个嘛……等到了树屋再告诉你。",
      "voice": "ch_10021/Main/1101/1101_10021_254",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "赛莲",
      "text": "这不是超级危险吗！！",
      "voice": "ch_10023/Main/1101/1101_10023_255",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "琳",
      "text": "主人，这次总算是私奔了吧！？\n去哪里！？\n要去哪里私奔！？",
      "voice": "ch_10006/Main/1101/1101_10006_256",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "*有白狗、开着白花的庭院的白房子",
      "text": "有白色之犬与白色之花绽于白色之庭的白色之家",
      "voice": "",
      "command": "Selection"
    },
    {
      "row": 68,
      "speaker": "*史莱姆之乡",
      "text": "史莱姆之乡",
      "voice": "",
      "command": "Selection"
    },
    {
      "row": 72,
      "speaker": "克萝米",
      "text": "你很喜欢白色呢……。\n不过，我的名字也叫白萝米就是了。",
      "voice": "ch_10021/Main/1101/1101_10021_257",
      "command": ""
    },
    {
      "row": 74,
      "speaker": "赛莲",
      "text": "你居然不动声色地改名字！",
      "voice": "ch_10023/Main/1101/1101_10023_258",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "赛莲",
      "text": "……不过嘛，这个构想倒不坏。\n白房子加一个小庭院，是吧。",
      "voice": "ch_10023/Main/1101/1101_10023_259",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "弗兰茜",
      "text": "赛莲虽然是那副样子，内心倒意外地是个少女。",
      "voice": "ch_10014/Main/1101/1101_10014_260",
      "command": ""
    },
    {
      "row": 79,
      "speaker": "克萝米",
      "text": "挺意外的呢。",
      "voice": "ch_10021/Main/1101/1101_10021_261",
      "command": ""
    },
    {
      "row": 82,
      "speaker": "赛莲",
      "text": "白色餐桌上摆着白色的素面、白色的牛奶、白色的豆腐。",
      "voice": "ch_10023/Main/1101/1101_10023_262",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "赛莲",
      "text": "然后，微笑着在庭院里晾白色床单的、\n穿着白色连衣裙的主人……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "铃",
      "text": "嗯嗯嗯？？？\n刚才是不是混进了什么奇怪的东西？",
      "voice": "ch_10022/Main/1101/1101_10022_263",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "克萝米",
      "text": "说得也是呢。素面、牛奶\n加豆腐的菜单，是不是有点那个呢……。",
      "voice": "ch_10021/Main/1101/1101_10021_264",
      "command": ""
    },
    {
      "row": 90,
      "speaker": "铃",
      "text": "不是那个啦！？",
      "voice": "ch_10022/Main/1101/1101_10022_265",
      "command": ""
    },
    {
      "row": 91,
      "speaker": "琳",
      "text": "主人的白色连衣裙……。",
      "voice": "ch_10006/Main/1101/1101_10006_266",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "铃",
      "text": "对，就是那个！",
      "voice": "ch_10022/Main/1101/1101_10022_267",
      "command": ""
    },
    {
      "row": 93,
      "speaker": "琳",
      "text": "感觉挺合适的……。",
      "voice": "ch_10006/Main/1101/1101_10006_268",
      "command": ""
    },
    {
      "row": 94,
      "speaker": "铃",
      "text": "啊啊……嗯……是……呢。",
      "voice": "ch_10022/Main/1101/1101_10022_269",
      "command": ""
    },
    {
      "row": 95,
      "speaker": "主人公",
      "text": "总觉得，大家看我的眼神都扭曲了！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 126,
      "speaker": "琳",
      "text": "果然，史莱姆之血在躁动呢，主人！",
      "voice": "ch_10006/Main/1101/1101_10006_270",
      "command": ""
    },
    {
      "row": 131,
      "speaker": "铃",
      "text": "史莱姆之乡是什么样的地方？",
      "voice": "ch_10022/Main/1101/1101_10022_271",
      "command": ""
    },
    {
      "row": 132,
      "speaker": "琳",
      "text": "有史莱姆之犬与史莱姆之花绽于史莱姆之庭，\n有一排排史莱姆房子的村子哦。",
      "voice": "ch_10006/Main/1101/1101_10006_272",
      "command": ""
    },
    {
      "row": 133,
      "speaker": "赛莲",
      "text": "那村子好吓人啊！\n黏糊糊的吧！",
      "voice": "ch_10023/Main/1101/1101_10023_273",
      "command": ""
    },
    {
      "row": 134,
      "speaker": "琳",
      "text": "主人本来就是史莱姆，肯定住得惯的。",
      "voice": "ch_10006/Main/1101/1101_10006_274",
      "command": ""
    },
    {
      "row": 135,
      "speaker": "赛莲",
      "text": "好可怕、主人好可怕！",
      "voice": "ch_10023/Main/1101/1101_10023_275",
      "command": ""
    },
    {
      "row": 149,
      "speaker": "",
      "text": "就在这时。\n咚！　咚！　咚！！\n伴随着地鸣般的巨响，地面剧烈摇晃起来。",
      "voice": "",
      "command": ""
    },
    {
      "row": 153,
      "speaker": "弗兰茜",
      "text": "……怎、怎么了？",
      "voice": "ch_10014/Main/1101/1101_10014_276",
      "command": ""
    },
    {
      "row": 154,
      "speaker": "特鲁鲁",
      "text": "嘘！\n是从那边过来的汪。",
      "voice": "ch_10027/Main/1101/1101_10027_280",
      "command": ""
    },
    {
      "row": 159,
      "speaker": "",
      "text": "把树木尽数铲平，把巨岩尽数铲平，把残兵也尽数铲平，\n总之就是一副最爱铲平一切的气势铲平而来，\n现身的是一具拥有异样巨体的大汉。",
      "voice": "",
      "command": ""
    },
    {
      "row": 165,
      "speaker": "铃",
      "text": "那、那个大汉是什么！？\n有109大厦的招牌广告牌那么大呀！？（涉谷109大厦）",
      "voice": "ch_10022/Main/1101/1101_10022_281",
      "command": ""
    },
    {
      "row": 166,
      "speaker": "赛莲",
      "text": "什么呀，109是什么？",
      "voice": "ch_10023/Main/1101/1101_10023_282",
      "command": ""
    },
    {
      "row": 167,
      "speaker": "铃",
      "text": "大概有铃○赛道泳池里那个会往下泼水的\n巨型水桶那么高吧！？（铃鹿赛道）",
      "voice": "ch_10022/Main/1101/1101_10022_283",
      "command": ""
    },
    {
      "row": 168,
      "speaker": "赛莲",
      "text": "什么呀，铃○赛道又是什么？",
      "voice": "ch_10023/Main/1101/1101_10023_284",
      "command": ""
    },
    {
      "row": 169,
      "speaker": "主人公",
      "text": "呜呜……所以我都说快逃了嘛……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 174,
      "speaker": "克萝米",
      "text": "乖乖乖，到姐姐怀里哭吧。",
      "voice": "ch_10021/Main/1101/1101_10021_285",
      "command": ""
    },
    {
      "row": 175,
      "speaker": "琳",
      "text": "好狡猾呀，我也要让你在我怀里哭！",
      "voice": "ch_10006/Main/1101/1101_10006_286",
      "command": ""
    },
    {
      "row": 180,
      "speaker": "弗兰茜",
      "text": "也算本公主一个。",
      "voice": "ch_10014/Main/1101/1101_10014_287",
      "command": ""
    },
    {
      "row": 181,
      "speaker": "特鲁鲁",
      "text": "汪也算一个。",
      "voice": "ch_10027/Main/1101/1101_10027_288",
      "command": ""
    },
    {
      "row": 194,
      "speaker": "薇薇神",
      "text": "你们还有闲工夫做这些吗。\n瞧，都已经逼到眼前了。",
      "voice": "ch_30005/Main/1101/1101_30005_289",
      "command": ""
    },
    {
      "row": 225,
      "speaker": "迈纳德",
      "text": "哇哈哈哈哈哈！！\n下等的魔物娘们，别太得意忘形！！\n在我骑士团的杀手锏、这张王牌面前跪下吧！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 226,
      "speaker": "迈纳德",
      "text": "上！！\n大战士·德凯奥！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 229,
      "speaker": "德凯奥",
      "text": "是——。",
      "voice": "en_40125/Main/1101/1101_40125_290",
      "command": ""
    },
    {
      "row": 246,
      "speaker": "赛莲",
      "text": "声音挺可爱的嘛，德凯奥！？",
      "voice": "ch_10023/Main/1101/1101_10023_291",
      "command": ""
    },
    {
      "row": 249,
      "speaker": "琳",
      "text": "说话方式也可爱呢。",
      "voice": "ch_10006/Main/1101/1101_10006_292",
      "command": ""
    },
    {
      "row": 254,
      "speaker": "铃",
      "text": "话说，名字叫德凯奥啊。\n要是他没长成『巨大』的样子，他爹妈当初打算怎么办呀？",
      "voice": "ch_10022/Main/1101/1101_10022_293",
      "command": ""
    },
    {
      "row": 268,
      "speaker": "迈纳德",
      "text": "哎呀，吵死了，这帮小丫头！！\n把他们统统踢飞，德凯奥！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 269,
      "speaker": "德凯奥",
      "text": "收—到—。",
      "voice": "en_40125/Main/1101/1101_40125_294",
      "command": ""
    },
    {
      "row": 300,
      "speaker": "琳",
      "text": "一拳就在地上砸出个大洞了呀！？\n好可怕，主人！",
      "voice": "ch_10006/Main/1101/1101_10006_295",
      "command": ""
    },
    {
      "row": 303,
      "speaker": "琳",
      "text": "带我一起逃吧，在逃亡的地方结婚好不好？",
      "voice": "ch_10006/Main/1101/1101_10006_296",
      "command": ""
    },
    {
      "row": 304,
      "speaker": "主人公",
      "text": "以那种步幅追过来，我们根本逃不掉啊，\n话说回来，现在也不是结婚的时候吧！",
      "voice": "",
      "command": ""
    },
    {
      "row": 307,
      "speaker": "克萝米",
      "text": "呀——，我也好怕——，主～人～。",
      "voice": "ch_10021/Main/1101/1101_10021_297",
      "command": ""
    },
    {
      "row": 308,
      "speaker": "特鲁鲁",
      "text": "你们几个，还有闲工夫黏黏糊糊地贴在一起吗汪！？",
      "voice": "ch_10027/Main/1101/1101_10027_298",
      "command": ""
    },
    {
      "row": 313,
      "speaker": "赛莲",
      "text": "那几个家伙，是不是对我的主人太亲昵了点？",
      "voice": "ch_10023/Main/1101/1101_10023_299",
      "command": ""
    },
    {
      "row": 314,
      "speaker": "弗兰茜",
      "text": "所以才说，这种话要当着本人的面说呀。",
      "voice": "ch_10014/Main/1101/1101_10014_300",
      "command": ""
    },
    {
      "row": 315,
      "speaker": "主人公",
      "text": "大家别挤在一起！　会被一网打尽的！\n散开，向四面散开！",
      "voice": "",
      "command": ""
    },
    {
      "row": 320,
      "speaker": "琳",
      "text": "切～……。",
      "voice": "ch_10006/Main/1101/1101_10006_301",
      "command": ""
    },
    {
      "row": 321,
      "speaker": "特鲁鲁",
      "text": "你们几个，还挺有余裕的嘛汪……。",
      "voice": "ch_10027/Main/1101/1101_10027_302",
      "command": ""
    },
    {
      "row": 324,
      "speaker": "主人公",
      "text": "迎击！\n请把力量借给我！！\n没事的，我一定会保护大家！",
      "voice": "",
      "command": ""
    },
    {
      "row": 329,
      "speaker": "琳",
      "text": "讨厌，好帅……\n绝对要拿来当发泄性欲的对象……。（汪）（的说）",
      "voice": "ch_10006/Main/1101/1101_10006_303",
      "command": ""
    }
  ]
}
