{
  "scenario_id": "1101011nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1101/1101011nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\a5bd0e098b44f639eb6fcdc07c13be622d8f45e86c4c382a2c83d62fa7e6f6b3\\a5bd0e098b44f639eb6fcdc07c13be62\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "――拉希奥王国。\n离戈什佩恩斯岛最近，也是大陆上屈指可数的历史悠久的强国。\n在其拥有港湾都市的首都、奥拉希翁市的一间酒馆角落——。",
      "voice": "",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "艾洛依兹",
      "text": "真是的，那小鬼！　就差一点就能抓住魅魔娘、\n把她卖掉大赚一笔，用香槟泳池当床、\n用牛郎当褥子，从此奢侈享乐了呀！！",
      "voice": "en_40112/Main/1101/1101_40112_001",
      "command": ""
    },
    {
      "row": 51,
      "speaker": "梅吉",
      "text": "艾洛依兹大人这种庸俗的地方，我挺中意的。\n不过真要那么干的话，艾洛依兹大人这会儿\n早以溺死男公关的罪名蹲进牢里了。",
      "voice": "en_40113/Main/1101/1101_40113_002",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "卡蜜拉",
      "text": "所以，我才如此进言。\n此乃违背神的旨意之举。纵然是魔物娘，\n也是有生命、有心灵的存在。岂能将她们如同奴隶一般卖掉……。",
      "voice": "en_40114/Main/1101/1101_40114_003",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "艾洛依兹",
      "text": "啊——行了，我都说了知道了啦！\n喝！　一醉忘千愁！！\n店员小哥——，气泡饮料再来一杯呀——！",
      "voice": "en_40112/Main/1101/1101_40112_004",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "？？？",
      "text": "各位要是忘记了我可就头疼了。\n那段话，我想听一听。",
      "voice": "en_40147/Main/1101/1101_40147_005",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "艾洛依兹",
      "text": "啊？　你谁啊？",
      "voice": "en_40112/Main/1101/1101_40112_006",
      "command": ""
    },
    {
      "row": 71,
      "speaker": "？？？",
      "text": "失礼了。我是希斯。\n王国骑士团，副骑士团长。",
      "voice": "en_40147/Main/1101/1101_40147_007",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "艾洛依兹",
      "text": "哦哦哦哦哦，王国骑士！？\n那、那么，骑士大人找小女子有何贵干？",
      "voice": "en_40112/Main/1101/1101_40112_008",
      "command": ""
    },
    {
      "row": 100,
      "speaker": "梅吉",
      "text": "艾洛依兹大人庸俗得过头的这点，\n说实话我也觉得有点那个。",
      "voice": "en_40113/Main/1101/1101_40113_009",
      "command": ""
    },
    {
      "row": 103,
      "speaker": "希斯",
      "text": "没什么，只是想听你们说说\n那个你们见过的小鬼的事。",
      "voice": "en_40147/Main/1101/1101_40147_010",
      "command": ""
    },
    {
      "row": 109,
      "speaker": "艾洛依兹等人",
      "text": "啊？？？",
      "voice": "en_40112/Main/1101/1101_40112_011",
      "command": ""
    },
    {
      "row": 119,
      "speaker": "",
      "text": "另一方面，戈什佩恩斯岛上，一场始料未及的战火正开始闷烧。",
      "voice": "",
      "command": ""
    },
    {
      "row": 124,
      "speaker": "克萝米",
      "text": "主人是我们重要的资产！\n自由而开放的情欲，将照亮这座岛的未来！",
      "voice": "ch_10021/Main/1101/1101_10021_014",
      "command": ""
    },
    {
      "row": 126,
      "speaker": "赛莲",
      "text": "异议！！\n所谓自由的情欲，只会催生败坏的風纪！\n唯有彻彻底底的射精管理，才能给这座岛带来阴道……引导！！",
      "voice": "ch_10023/Main/1101/1101_10023_015",
      "command": ""
    },
    {
      "row": 129,
      "speaker": "",
      "text": "这场战事，后世称之为『戈什佩恩斯岛·少年革命战争』。",
      "voice": "",
      "command": ""
    },
    {
      "row": 130,
      "speaker": "",
      "text": "企图将少年当作扭曲性癖发泄口的一派，\n与同样企图将少年当作扭曲性癖发泄口的一派之间，\n爆发的一场以爱液洗爱液、爱液淋漓的腥臭战争。",
      "voice": "",
      "command": ""
    },
    {
      "row": 142,
      "speaker": "铃",
      "text": "呐——，克萝米，快别闹啦——。\n争执是不好的哦——。",
      "voice": "ch_10022/Main/1101/1101_10022_016",
      "command": ""
    },
    {
      "row": 147,
      "speaker": "弗兰茜",
      "text": "赛莲，快点为本公主把少年带来呀。这是你的职责吧。",
      "voice": "ch_10014/Main/1101/1101_10014_017",
      "command": ""
    },
    {
      "row": 159,
      "speaker": "赛莲",
      "text": "才不是为了你！",
      "voice": "ch_10023/Main/1101/1101_10023_018",
      "command": ""
    },
    {
      "row": 162,
      "speaker": "",
      "text": "以与自由的少年卿卿我我为核心，提出政策",
      "voice": "",
      "command": ""
    },
    {
      "row": 166,
      "speaker": "",
      "text": "除琳·克萝米之外，",
      "voice": "",
      "command": ""
    },
    {
      "row": 170,
      "speaker": "",
      "text": "再加上虽是百般不愿、却被青梅竹马克萝米\n卷进来的铃，这便是三人娘的『轴心』。",
      "voice": "",
      "command": ""
    },
    {
      "row": 175,
      "speaker": "",
      "text": "与这一轴心相对抗的，是龙娘·赛莲、",
      "voice": "",
      "command": ""
    },
    {
      "row": 180,
      "speaker": "",
      "text": "阿拉克涅娘·弗兰茜、",
      "voice": "",
      "command": ""
    },
    {
      "row": 182,
      "speaker": "",
      "text": "以及刻耳柏洛斯娘·特鲁鲁所结成的、",
      "voice": "",
      "command": ""
    },
    {
      "row": 183,
      "speaker": "",
      "text": "以彻底的射精管理为基轴、\n以期建成管理社会、并以血之盟约缔结的三人娘之『血盟』。",
      "voice": "",
      "command": ""
    },
    {
      "row": 186,
      "speaker": "赛莲",
      "text": "我等血盟，虽要求彻底的射精管理，\n却也并非有意让此次谈判破裂！\n故此，我方愿作让步：每日至多三次的射精，当予自由。",
      "voice": "ch_10023/Main/1101/1101_10023_019",
      "command": ""
    },
    {
      "row": 191,
      "speaker": "克萝米",
      "text": "三次太少了！　至少，五次……不，十次吧！",
      "voice": "ch_10021/Main/1101/1101_10021_020",
      "command": ""
    },
    {
      "row": 204,
      "speaker": "特鲁鲁",
      "text": "那也太多了汪！？",
      "voice": "ch_10027/Main/1101/1101_10027_021",
      "command": ""
    },
    {
      "row": 209,
      "speaker": "琳",
      "text": "三次也行啦，不过在性器以外的地方射出来的不算数哦！",
      "voice": "ch_10006/Main/1101/1101_10006_022",
      "command": ""
    },
    {
      "row": 222,
      "speaker": "弗兰茜",
      "text": "不对，凭你那史莱姆状的身体，这个条件太犯规了呀！？\n毕竟你能变成让人分不清哪是哪的状态呀！？",
      "voice": "ch_10014/Main/1101/1101_10014_023",
      "command": ""
    },
    {
      "row": 239,
      "speaker": "铃",
      "text": "……话说回来，只要反复寸止，\n次数什么的就没意义了吧？",
      "voice": "ch_10022/Main/1101/1101_10022_024",
      "command": ""
    },
    {
      "row": 240,
      "speaker": "克萝米",
      "text": "就是这个呀，铃！",
      "voice": "ch_10021/Main/1101/1101_10021_025",
      "command": ""
    },
    {
      "row": 243,
      "speaker": "赛莲",
      "text": "你们几个，别仗着我方让步就信口开河！\n决裂了，决裂！！",
      "voice": "ch_10023/Main/1101/1101_10023_026",
      "command": ""
    },
    {
      "row": 244,
      "speaker": "",
      "text": "如上所述，谈判的内容，\n实在令人忍不住想说『你们别把这种事当正经议题啊』，\n堪称相当不堪。",
      "voice": "",
      "command": ""
    },
    {
      "row": 247,
      "speaker": "",
      "text": "而当事人主人公呢，\n尽管主权正遭受侵犯，\n却始终处于失神状态，呆然出神。",
      "voice": "",
      "command": ""
    },
    {
      "row": 248,
      "speaker": "琳",
      "text": "怎么啦，主人？\n在发呆吗？",
      "voice": "ch_10006/Main/1101/1101_10006_027",
      "command": ""
    },
    {
      "row": 250,
      "speaker": "主人公",
      "text": "呀啊啊啊啊啊！？\n琳、琳、琳琳琳小姐！？\n没、没、什么都没有啦！",
      "voice": "",
      "command": ""
    },
    {
      "row": 251,
      "speaker": "琳",
      "text": "诶～？\n为什么要拉开距离呀？\n而且，主人你的脸好红哦？",
      "voice": "ch_10006/Main/1101/1101_10006_028",
      "command": ""
    },
    {
      "row": 252,
      "speaker": "主人公",
      "text": "因、因、因为，和琳小姐……那、那、那种事……！\n……什么都没有啦！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 283,
      "speaker": "克萝米",
      "text": "哦？　是色色的话题呀？\n魅魔娘对色色对话的气味可是很敏感的哦！\n在聊什么呢？　是喂奶色色的话题吗？",
      "voice": "ch_10021/Main/1101/1101_10021_029",
      "command": ""
    },
    {
      "row": 285,
      "speaker": "主人公",
      "text": "我才没在说那种话啦！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 288,
      "speaker": "",
      "text": "此后，虽经反复折衝，却仍不断决裂，\n那种彻底的对立结构，已然严重到\n无法避免正面的军事对决。",
      "voice": "",
      "command": ""
    },
    {
      "row": 296,
      "speaker": "",
      "text": "于是，迎来了第82回轴心·血盟会谈。",
      "voice": "",
      "command": ""
    },
    {
      "row": 299,
      "speaker": "弗兰茜",
      "text": "那个……上次会议临近结束时，议题是什么来着？",
      "voice": "ch_10014/Main/1101/1101_10014_030",
      "command": ""
    },
    {
      "row": 300,
      "speaker": "铃",
      "text": "好像是抱怨会议上的茶点净是甜的，\n希望偶尔也上点咸的……来着？",
      "voice": "ch_10022/Main/1101/1101_10022_031",
      "command": ""
    },
    {
      "row": 305,
      "speaker": "克萝米",
      "text": "不过呀，我总觉得用不了多久，\n就会因为主人而想吃酸的东西了呢。",
      "voice": "ch_10021/Main/1101/1101_10021_032",
      "command": ""
    },
    {
      "row": 306,
      "speaker": "赛莲",
      "text": "你是孕妇吗！",
      "voice": "ch_10023/Main/1101/1101_10023_033",
      "command": ""
    },
    {
      "row": 307,
      "speaker": "赛莲",
      "text": "那么，主人想要什么样的茶点呢？\n甜的、咸的、酸的，还是说……。",
      "voice": "ch_10023/Main/1101/1101_10023_034",
      "command": ""
    },
    {
      "row": 310,
      "speaker": "*咸食",
      "text": "咸食",
      "voice": "",
      "command": "Selection"
    },
    {
      "row": 311,
      "speaker": "*酸食",
      "text": "酸食",
      "voice": "",
      "command": "Selection"
    },
    {
      "row": 312,
      "speaker": "*欧派食",
      "text": "欧派食",
      "voice": "",
      "command": "Selection"
    },
    {
      "row": 316,
      "speaker": "赛莲",
      "text": "男孩子就是喜欢咸的呢，嗯嗯。",
      "voice": "ch_10023/Main/1101/1101_10023_035",
      "command": ""
    },
    {
      "row": 327,
      "speaker": "弗兰茜",
      "text": "又摆出那副事后诸葛亮的嘴脸……。",
      "voice": "ch_10014/Main/1101/1101_10014_036",
      "command": ""
    },
    {
      "row": 332,
      "speaker": "琳",
      "text": "来，主人，是咸味肉冻哦。",
      "voice": "ch_10006/Main/1101/1101_10006_037",
      "command": ""
    },
    {
      "row": 333,
      "speaker": "主人公",
      "text": "嗯……好吃是好吃，可拿来当茶点是不是有点……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 334,
      "speaker": "赛莲",
      "text": "话说回来，琳，你刚才那东西是从哪儿掏出来的？",
      "voice": "ch_10023/Main/1101/1101_10023_038",
      "command": ""
    },
    {
      "row": 335,
      "speaker": "琳",
      "text": "是少女的秘密哦。",
      "voice": "ch_10006/Main/1101/1101_10006_039",
      "command": ""
    },
    {
      "row": 338,
      "speaker": "薇薇神",
      "text": "据说史莱姆娘能从身体的任何地方，\n变出胶状的东西来呢。",
      "voice": "ch_30005/Main/1101/1101_30005_040",
      "command": ""
    },
    {
      "row": 353,
      "speaker": "赛莲",
      "text": "不不不不，可是，你刚才是把手伸进某个\n裙子似的、软趴趴的东西里掏出来的吧，那个！？",
      "voice": "ch_10023/Main/1101/1101_10023_041",
      "command": ""
    },
    {
      "row": 354,
      "speaker": "特鲁鲁",
      "text": "赛莲，算了吧汪。\n都吃下去的主人看着都快哭了汪。",
      "voice": "ch_10027/Main/1101/1101_10027_042",
      "command": ""
    },
    {
      "row": 355,
      "speaker": "赛莲",
      "text": "哦、哦……。",
      "voice": "ch_10023/Main/1101/1101_10023_043",
      "command": ""
    },
    {
      "row": 359,
      "speaker": "克萝米",
      "text": "哦？　做好了呀？",
      "voice": "ch_10021/Main/1101/1101_10021_044",
      "command": ""
    },
    {
      "row": 360,
      "speaker": "主人公",
      "text": "才没有做好……应该说，根本做不出来……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 363,
      "speaker": "铃",
      "text": "突然说要酸的东西，我也来不及准备呀。",
      "voice": "ch_10022/Main/1101/1101_10022_045",
      "command": ""
    },
    {
      "row": 366,
      "speaker": "赛莲",
      "text": "又苦又酸的东西倒是有呢。",
      "voice": "ch_10023/Main/1101/1101_10023_046",
      "command": ""
    },
    {
      "row": 367,
      "speaker": "铃",
      "text": "那不就是烂西瓜吗！？",
      "voice": "ch_10022/Main/1101/1101_10022_047",
      "command": ""
    },
    {
      "row": 399,
      "speaker": "克萝米",
      "text": "嗯～真是的，主人也真是个男孩子呢。\n来，请吧～。",
      "voice": "ch_10021/Main/1101/1101_10021_048",
      "command": ""
    },
    {
      "row": 400,
      "speaker": "主人公",
      "text": "什么叫请吧！？\n再说，那又不是我自己选的！\n是赛莲小姐半强迫地让我选的……！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 403,
      "speaker": "赛莲",
      "text": "男人都会这么说呢——。",
      "voice": "ch_10023/Main/1101/1101_10023_049",
      "command": ""
    },
    {
      "row": 406,
      "speaker": "主人公",
      "text": "太过分了，赛莲小姐！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 407,
      "speaker": "克萝米",
      "text": "好了好了，来来来，是姐姐的胸部哦～。\n要乖乖的哟～。",
      "voice": "ch_10021/Main/1101/1101_10021_050",
      "command": ""
    },
    {
      "row": 408,
      "speaker": "主人公",
      "text": "你开始用婴儿腔了！",
      "voice": "",
      "command": ""
    },
    {
      "row": 411,
      "speaker": "克萝米",
      "text": "来嘛，主人酱，啊——呜～的哟～？\n是奶奶哟～？",
      "voice": "ch_10021/Main/1101/1101_10021_051",
      "command": ""
    },
    {
      "row": 412,
      "speaker": "主人公",
      "text": "你的眼神是认真的，好可怕！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 417,
      "speaker": "赛莲",
      "text": "话说，茶点什么的根本无所谓啦！\n重要的是，到底是谁的胸部\n能把主人拿下啊！？",
      "voice": "ch_10023/Main/1101/1101_10023_052",
      "command": ""
    },
    {
      "row": 420,
      "speaker": "主人公",
      "text": "彻底变成胸部的话题了……。\n话说，我还以为铃小姐\n是更认真一些的人呢……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 433,
      "speaker": "铃",
      "text": "诶！？　我明明还挺认真的呀！？　对吧！？",
      "voice": "ch_10022/Main/1101/1101_10022_053",
      "command": ""
    },
    {
      "row": 436,
      "speaker": "薇薇神",
      "text": "相较之下，周围的对象实在太不认真了，让人很难置评呢。",
      "voice": "ch_30005/Main/1101/1101_30005_054",
      "command": ""
    },
    {
      "row": 461,
      "speaker": "铃",
      "text": "诶、诶？　等、等一下？\n先等一下？\n在主人看来，我是怎样的一个人呢？",
      "voice": "ch_10022/Main/1101/1101_10022_055",
      "command": ""
    },
    {
      "row": 462,
      "speaker": "主人公",
      "text": "那个……感觉挺有常识的，看起来很温柔……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 463,
      "speaker": "铃",
      "text": "看吧——。",
      "voice": "ch_10022/Main/1101/1101_10022_056",
      "command": ""
    },
    {
      "row": 464,
      "speaker": "赛莲",
      "text": "那得意的表情真够可以的……。",
      "voice": "ch_10023/Main/1101/1101_10023_057",
      "command": ""
    },
    {
      "row": 465,
      "speaker": "主人公",
      "text": "不过，毕竟是半人马娘嘛，\n第一印象我还以为你更一板一眼一些……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 479,
      "speaker": "铃",
      "text": "等一下。\n你刚才说什么？",
      "voice": "ch_10022/Main/1101/1101_10022_058",
      "command": ""
    },
    {
      "row": 480,
      "speaker": "主人公",
      "text": "诶……更一板一眼的……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 481,
      "speaker": "铃",
      "text": "不对不对。\n再往前。",
      "voice": "ch_10022/Main/1101/1101_10022_059",
      "command": ""
    },
    {
      "row": 482,
      "speaker": "主人公",
      "text": "……因为是半人马娘？",
      "voice": "",
      "command": ""
    },
    {
      "row": 495,
      "speaker": "铃",
      "text": "不对不对不对，不——对！！",
      "voice": "ch_10022/Main/1101/1101_10022_060",
      "command": ""
    },
    {
      "row": 498,
      "speaker": "铃",
      "text": "我！　",
      "voice": "",
      "command": ""
    },
    {
      "row": 501,
      "speaker": "铃",
      "text": "才不是半人马娘！　",
      "voice": "",
      "command": ""
    },
    {
      "row": 506,
      "speaker": "铃",
      "text": "呢——！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 531,
      "speaker": "克萝米",
      "text": "啊啊……你踩到铃唯一的雷点了……。",
      "voice": "ch_10021/Main/1101/1101_10021_061",
      "command": ""
    },
    {
      "row": 532,
      "speaker": "主人公",
      "text": "诶……这是什么意思……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 533,
      "speaker": "克萝米",
      "text": "铃在外形上几乎就是半人马娘，\n其实却是天马娘。差别只在于有没有一对小翅膀，\n很多人都分不出来呢。",
      "voice": "ch_10021/Main/1101/1101_10021_062",
      "command": ""
    },
    {
      "row": 534,
      "speaker": "克萝米",
      "text": "在铃看来，半人马不可爱，天马才可爱。\n所以一旦被误认成半人马娘，\n她就会以足以毁灭这个世界的气势暴怒起来哦～。",
      "voice": "ch_10021/Main/1101/1101_10021_063",
      "command": ""
    },
    {
      "row": 535,
      "speaker": "主人公",
      "text": "这种事就不能先去跟我说一声吗！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 536,
      "speaker": "克萝米",
      "text": "诶～，居然希望我先『去』一步呀，\n主人意外地很色情呢。",
      "voice": "ch_10021/Main/1101/1101_10021_064",
      "command": ""
    },
    {
      "row": 538,
      "speaker": "主人公",
      "text": "我才没在说那种事！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 543,
      "speaker": "赛莲",
      "text": "喂，主人，你还是赶紧道歉比较好哦？\n就说『对不起，半人马』。",
      "voice": "ch_10023/Main/1101/1101_10023_065",
      "command": ""
    },
    {
      "row": 544,
      "speaker": "主人公",
      "text": "根本没有道歉的意思！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 545,
      "speaker": "克萝米",
      "text": "赛莲以前就曾当着铃的面，\n直言她是『山寨半人马』，\n结果被打折了肋骨呢。",
      "voice": "ch_10021/Main/1101/1101_10021_066",
      "command": ""
    },
    {
      "row": 546,
      "speaker": "赛莲",
      "text": "所以啊，你还是道歉比较好哦？\n就说『对不起，山寨版·半人马』。",
      "voice": "ch_10023/Main/1101/1101_10023_067",
      "command": ""
    },
    {
      "row": 547,
      "speaker": "主人公",
      "text": "为什么你们连我的肋骨都想折断啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 551,
      "speaker": "主人公",
      "text": "……那、那个，铃小姐。对不起，是我认错了。\n仔细一看，你的翅膀，很可爱呢。",
      "voice": "",
      "command": ""
    },
    {
      "row": 580,
      "speaker": "铃",
      "text": "是吧！？\n天马娘就是可爱呀。",
      "voice": "ch_10022/Main/1101/1101_10022_068",
      "command": ""
    },
    {
      "row": 585,
      "speaker": "弗兰茜",
      "text": "太好打发了啊。",
      "voice": "ch_10014/Main/1101/1101_10014_069",
      "command": ""
    },
    {
      "row": 586,
      "speaker": "特鲁鲁",
      "text": "太好打发了汪。",
      "voice": "ch_10027/Main/1101/1101_10027_070",
      "command": ""
    },
    {
      "row": 589,
      "speaker": "主人公",
      "text": "话说，『半人马』这个种族，本来就已经有一半\n是人形了吧？那么更接近人类的『半人马娘』，\n和半人马的女性又有什么不同呢？",
      "voice": "",
      "command": ""
    },
    {
      "row": 612,
      "speaker": "赛莲",
      "text": "你啊，可别随随便便就去触碰\n这个世界不可涉足的谜团啊……。",
      "voice": "ch_10023/Main/1101/1101_10023_071",
      "command": ""
    },
    {
      "row": 616,
      "speaker": "薇薇神",
      "text": "话说回来，话题已经严重跑偏了呢。",
      "voice": "ch_30005/Main/1101/1101_30005_072",
      "command": ""
    },
    {
      "row": 621,
      "speaker": "赛莲",
      "text": "对对。\n该讨论的是，要如何名正言顺地\n和主人卿卿我我、黏黏糊糊才对啊……。",
      "voice": "ch_10023/Main/1101/1101_10023_073",
      "command": ""
    },
    {
      "row": 622,
      "speaker": "克萝米",
      "text": "真是的。赛莲不过是不受雄性待见，\n也用不着这么猴急呀～。\n在情欲上该更从容一点才行～。",
      "voice": "ch_10021/Main/1101/1101_10021_074",
      "command": ""
    },
    {
      "row": 635,
      "speaker": "赛莲",
      "text": "你说什么，你这混账！！\n既然如此，那就开战！！\n还有，我可不想被你这么说！！",
      "voice": "ch_10023/Main/1101/1101_10023_075",
      "command": ""
    },
    {
      "row": 640,
      "speaker": "特鲁鲁",
      "text": "要上就上汪！！",
      "voice": "ch_10027/Main/1101/1101_10027_076",
      "command": ""
    },
    {
      "row": 641,
      "speaker": "",
      "text": "就这样，战端在不知不觉间开启了。\n什么以高度政治判断为前提的谈判破裂，早已无关紧要，\n不过是一时恼羞成怒的互殴罢了……。",
      "voice": "",
      "command": ""
    }
  ]
}
