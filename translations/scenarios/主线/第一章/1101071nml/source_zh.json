{
  "scenario_id": "1101071nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1101/1101071nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\f14f1b15b07213ecf21854c578c622802932fb2840e4678fa265b4e42b72f0fc\\f14f1b15b07213ecf21854c578c62280\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "主人公一行审问完骑士们，正在森林中休息。\n这时，满面油光的波德鲁回来了。\n腋下还夹着一名昏死过去的骑士。",
      "voice": "",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "波德鲁",
      "text": "哟——，我回来啦。\n嘿咻。",
      "voice": "ch_10011/Main/1101/1101_10011_234",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "主人公",
      "text": "嘶……那位身强力壮的骑士居然翻白眼了……。\n你到底做了什么呀？",
      "voice": "",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "波德鲁",
      "text": "什么什么的……那当然是、那个啦。就那个。\n都做到他自尊心咔嚓一声折断为止了！",
      "voice": "ch_10011/Main/1101/1101_10011_235",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "铃",
      "text": "别在主人君面前说些怪话……。\n『那个』是什么，本来就不需要知道嘛！",
      "voice": "ch_10022/Main/1101/1101_10022_236",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "主人公",
      "text": "呃、那个……。那么，问到情报了吗？",
      "voice": "",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "波德鲁",
      "text": "没，这家伙似乎也没被告知详情。\n总之命令好像是『找到主人，杀了他』。",
      "voice": "ch_10011/Main/1101/1101_10011_237",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "主人公",
      "text": "这样吗……。\n我们这边也只问到差不多的情报。",
      "voice": "",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "波德鲁",
      "text": "是吗。那这家伙就由我和兽人兄弟们\n扔到森林另一头去吧。",
      "voice": "ch_10011/Main/1101/1101_10011_238",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "铃",
      "text": "那我们继续担任主人君的护卫吧。",
      "voice": "ch_10022/Main/1101/1101_10022_239",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "波德鲁",
      "text": "嗯。千万要守住主人的贞操啊。\n难保没有家伙想走『先来一发……然后再对主人下手』的路子。",
      "voice": "ch_10011/Main/1101/1101_10011_240",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "主人公",
      "text": "你到底在担心什么啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "主人公",
      "text": "呼……到头来，情况也没什么变化啊。",
      "voice": "",
      "command": ""
    },
    {
      "row": 49,
      "speaker": "特鲁鲁",
      "text": "不过，活捉也就算了，居然要『杀掉』，\n这也太危险了汪。",
      "voice": "ch_10027/Main/1101/1101_10027_241",
      "command": ""
    },
    {
      "row": 50,
      "speaker": "弗兰茜",
      "text": "果然，只剩把主人绑起来\n监禁这一条路了。\n来吧，本公主会保护你的，做好觉悟吧。",
      "voice": "ch_10014/Main/1101/1101_10014_242",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "主人公",
      "text": "我从另一种意义上感到危机了！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "骑士A",
      "text": "喂，在这边！\n开始攻击！",
      "voice": "",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "琳",
      "text": "真是的～，因为主人你大声嚷嚷\n才被发现了呀！",
      "voice": "ch_10006/Main/1101/1101_10006_243",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "主人公",
      "text": "是我的错吗！？",
      "voice": "",
      "command": ""
    }
  ]
}
