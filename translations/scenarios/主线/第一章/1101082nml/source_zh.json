{
  "scenario_id": "1101082nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1101/1101082nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\9964d227e8446be3d0dd2d7d82e80e4797eb82bee9891a03e8b637460a259e9d\\9964d227e8446be3d0dd2d7d82e80e47\\__data",
  "rows": [
    {
      "row": 9,
      "speaker": "",
      "text": "伴随着地动山摇，德凯奥沉入了大地。",
      "voice": "",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "弗兰茜",
      "text": "毕竟体型巨大，相当难缠呢。",
      "voice": "ch_10014/Main/1101/1101_10014_306",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "赛莲",
      "text": "被折腾得够呛。\n不过，你那股坚韧的指挥还算可以，\n下次值得期待呢，主人。",
      "voice": "ch_10023/Main/1101/1101_10023_307",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "弗兰茜",
      "text": "所以才说，别站在远处绕着弯子说，\n直接对本人说呀。",
      "voice": "ch_10014/Main/1101/1101_10014_308",
      "command": ""
    },
    {
      "row": 17,
      "speaker": "主人公",
      "text": "大家有没有受伤？",
      "voice": "",
      "command": ""
    },
    {
      "row": 21,
      "speaker": "克萝米",
      "text": "受伤了！　请看，就是这里！",
      "voice": "ch_10021/Main/1101/1101_10021_309",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "主人公",
      "text": "不要把内裤脱下来！！\n那种地方怎么会精准受伤啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "迈纳德",
      "text": "可恶，怎么可能！！\n无敌的德凯奥居然会被打败！",
      "voice": "",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "薇薇神",
      "text": "？？？\n……请稍等片刻。总觉得样子不太对劲。",
      "voice": "ch_30005/Main/1101/1101_30005_310",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "铃",
      "text": "诶……？\n啊，德凯奥好像冒烟了！？",
      "voice": "ch_10022/Main/1101/1101_10022_311",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "主人公＆迈纳德",
      "text": "哈啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "特鲁鲁",
      "text": "哇哦！？\n身体到处都在剧烈地冒烟汪！！\n怎么回事汪！？",
      "voice": "ch_10027/Main/1101/1101_10027_312",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "弗兰茜",
      "text": "好像很不妙好像很不妙！！",
      "voice": "ch_10014/Main/1101/1101_10014_313",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "弗兰茜",
      "text": "……啊。\n……大汉背上的盖子打开了。",
      "voice": "ch_10014/Main/1101/1101_10014_314",
      "command": ""
    },
    {
      "row": 93,
      "speaker": "赛莲",
      "text": "背上的盖子！？",
      "voice": "ch_10023/Main/1101/1101_10023_315",
      "command": ""
    },
    {
      "row": 103,
      "speaker": "罗缇",
      "text": "咳咳！\n咳呃咳咳咳！！\n咳呕……呕。",
      "voice": "en_40125/Main/1101/1101_40125_316",
      "command": ""
    },
    {
      "row": 106,
      "speaker": "铃",
      "text": "从打开的背里，里面的人出来了！？",
      "voice": "ch_10022/Main/1101/1101_10022_317",
      "command": ""
    },
    {
      "row": 121,
      "speaker": "迈纳德",
      "text": "里面居然有人……！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 122,
      "speaker": "特鲁鲁",
      "text": "不，你竟然会惊讶吗汪。",
      "voice": "ch_10027/Main/1101/1101_10027_318",
      "command": ""
    },
    {
      "row": 126,
      "speaker": "罗缇",
      "text": "那当然啦，哪可能有这么巨大的人……。\n稍微想想就知道了嘛。",
      "voice": "en_40125/Main/1101/1101_40125_319",
      "command": ""
    },
    {
      "row": 159,
      "speaker": "赛莲",
      "text": "哼，我一开始就知道了！",
      "voice": "ch_10023/Main/1101/1101_10023_320",
      "command": ""
    },
    {
      "row": 161,
      "speaker": "特鲁鲁",
      "text": "骗人汪！！\n你一点那种自信都没露出过汪！！",
      "voice": "ch_10027/Main/1101/1101_10027_321",
      "command": ""
    },
    {
      "row": 162,
      "speaker": "赛莲",
      "text": "太明显的话，\n就会被说『诶？你居然不相信有巨大的人吗？』\n之类的嘛。",
      "voice": "ch_10023/Main/1101/1101_10023_322",
      "command": ""
    },
    {
      "row": 163,
      "speaker": "特鲁鲁",
      "text": "什么信不信的，\n那点事，随、便、啦汪！！",
      "voice": "ch_10027/Main/1101/1101_10027_323",
      "command": ""
    },
    {
      "row": 168,
      "speaker": "铃",
      "text": "呐、呐，我们不用逃吗？",
      "voice": "ch_10022/Main/1101/1101_10022_324",
      "command": ""
    },
    {
      "row": 169,
      "speaker": "弗兰茜",
      "text": "说得也是呢。",
      "voice": "ch_10014/Main/1101/1101_10014_325",
      "command": ""
    },
    {
      "row": 174,
      "speaker": "迈纳德",
      "text": "嗯？\n仔细一看，你不就是那个问题魔导师罗缇吗。",
      "voice": "",
      "command": ""
    },
    {
      "row": 176,
      "speaker": "罗缇",
      "text": "问题……。\n我可没惹出什么问题呀。",
      "voice": "en_40125/Main/1101/1101_40125_326",
      "command": ""
    },
    {
      "row": 188,
      "speaker": "迈纳德",
      "text": "有！　多得不得了！！\n你不但侵吞了宫廷魔导师的员工旅游公积金，\n连骑士团的运营费都贪污了！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 189,
      "speaker": "罗缇",
      "text": "用那笔钱研发出来的魔导地雷、魔导大剑、\n魔导机关枪和魔导包子，\n你知道为王国军立了多大功劳吗！？",
      "voice": "en_40125/Main/1101/1101_40125_327",
      "command": ""
    },
    {
      "row": 190,
      "speaker": "铃",
      "text": "魔导包子，有点在意呢。",
      "voice": "ch_10022/Main/1101/1101_10022_328",
      "command": ""
    },
    {
      "row": 191,
      "speaker": "弗兰茜",
      "text": "是呢。",
      "voice": "ch_10014/Main/1101/1101_10014_329",
      "command": ""
    },
    {
      "row": 192,
      "speaker": "罗缇",
      "text": "再说了，作为惩罚，把我当成零部件\n装进自己开发的德凯奥里当魔导控制元件，\n这也太不人道了吧！！　我要去劳动监察部门告你！！",
      "voice": "en_40125/Main/1101/1101_40125_330",
      "command": ""
    },
    {
      "row": 193,
      "speaker": "罗缇",
      "text": "而且！！你看！！　我都受伤了！！\n这已经算工伤了吧！！",
      "voice": "en_40125/Main/1101/1101_40125_331",
      "command": ""
    },
    {
      "row": 194,
      "speaker": "迈纳德",
      "text": "嗯，工伤应该会批下来吧。",
      "voice": "",
      "command": ""
    },
    {
      "row": 209,
      "speaker": "铃",
      "text": "还真会批啊！？",
      "voice": "ch_10022/Main/1101/1101_10022_332",
      "command": ""
    },
    {
      "row": 212,
      "speaker": "薇薇神",
      "text": "意外地还挺像良心企业的呢。",
      "voice": "ch_30005/Main/1101/1101_30005_333",
      "command": ""
    },
    {
      "row": 215,
      "speaker": "铃",
      "text": "不……都被人告到劳动监察部门了，这还能算良心企业……吗？",
      "voice": "ch_10022/Main/1101/1101_10022_334",
      "command": ""
    },
    {
      "row": 220,
      "speaker": "克萝米",
      "text": "话说回来～。\n我从刚才就一直很在意一件事。",
      "voice": "ch_10021/Main/1101/1101_10021_335",
      "command": ""
    },
    {
      "row": 222,
      "speaker": "赛莲",
      "text": "嗯，确实，魔导包子是什么味道我很在意。",
      "voice": "ch_10023/Main/1101/1101_10023_336",
      "command": ""
    },
    {
      "row": 224,
      "speaker": "克萝米",
      "text": "不是啦！！　是那个，那个。\n烟的颜色变得好黑，\n还有奇怪的噼啪声越来越响了，你们不觉得吗？",
      "voice": "ch_10021/Main/1101/1101_10021_337",
      "command": ""
    },
    {
      "row": 239,
      "speaker": "主人公",
      "text": "是说德凯奥……吧。\n确实，听得出某种不妙的、毁灭前的声响……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 252,
      "speaker": "罗缇",
      "text": "！？　糟、糟了！！\n撤退！！\n撤——————————退！！",
      "voice": "en_40125/Main/1101/1101_40125_338",
      "command": ""
    },
    {
      "row": 267,
      "speaker": "克萝米",
      "text": "哇，爆炸了！？",
      "voice": "ch_10021/Main/1101/1101_10021_339",
      "command": ""
    },
    {
      "row": 269,
      "speaker": "",
      "text": "伴随着德凯奥爆炸引发的轰鸣，\n主人公他们脚下的地面剧烈摇晃……然后。",
      "voice": "",
      "command": ""
    },
    {
      "row": 277,
      "speaker": "",
      "text": "以德凯奥为中心，周围的地面塌陷了。\n主人公他们……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 279,
      "speaker": "主人公",
      "text": "呜、哇啊啊啊啊啊啊啊啊啊啊啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 280,
      "speaker": "克萝米",
      "text": "呀啊啊啊啊啊啊啊啊啊啊啊啊啊啊！！",
      "voice": "ch_10021/Main/1101/1101_10021_340",
      "command": ""
    },
    {
      "row": 281,
      "speaker": "",
      "text": "他们就这样坠向了那豁然裂开的深渊之底……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 291,
      "speaker": "",
      "text": "因突然的地裂而坠入地底的主人公一行。\n躲过崩塌的特鲁鲁等人，\n呆然地俯视着他们消失的那个大洞。",
      "voice": "",
      "command": ""
    },
    {
      "row": 294,
      "speaker": "特鲁鲁",
      "text": "这、这下可糟了汪……。",
      "voice": "ch_10027/Main/1101/1101_10027_341",
      "command": ""
    },
    {
      "row": 296,
      "speaker": "弗兰茜",
      "text": "咿，用本公主的丝说不定能\n下到下面去！",
      "voice": "ch_10014/Main/1101/1101_10014_342",
      "command": ""
    },
    {
      "row": 298,
      "speaker": "特鲁鲁",
      "text": "等等汪！\n骑士团也一起掉下去了汪。",
      "voice": "ch_10027/Main/1101/1101_10027_343",
      "command": ""
    },
    {
      "row": 301,
      "speaker": "奎娜",
      "text": "要是在下面被包围了，根本撑不住的！",
      "voice": "ch_10058/Main/1101/1101_10058_344",
      "command": ""
    },
    {
      "row": 306,
      "speaker": "弗兰茜",
      "text": "话虽如此，就这样什么都不做也……。",
      "voice": "ch_10014/Main/1101/1101_10014_345",
      "command": ""
    },
    {
      "row": 307,
      "speaker": "特鲁鲁",
      "text": "主人他们一定还活着汪。\n为了总有一天到来的反击，\n我们要把主人的事告诉岛上的魔物娘们汪。",
      "voice": "ch_10027/Main/1101/1101_10027_346",
      "command": ""
    },
    {
      "row": 310,
      "speaker": "萨拉",
      "text": "是啊。哪怕多集结一个同伴，也好为决战做准备。",
      "voice": "ch_10057/Main/1101/1101_10057_347",
      "command": ""
    },
    {
      "row": 315,
      "speaker": "弗兰茜",
      "text": "可恶……明白了。\n主人，请等着我们……。",
      "voice": "ch_10014/Main/1101/1101_10014_348",
      "command": ""
    },
    {
      "row": 318,
      "speaker": "",
      "text": "怀着依依不舍的心情，弗兰茜她们离开了现场。\n她们的这个决定，将在即将到来的战斗中发挥重要作用，\n不过那都是后话了——。",
      "voice": "",
      "command": ""
    }
  ]
}
