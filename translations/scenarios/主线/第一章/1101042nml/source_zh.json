{
  "scenario_id": "1101042nml",
  "asset_path": "assets/advscene/scenarioexcel/main/1101/1101042nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\f18dad77d3f4ba8c594de9b3de4ce1a006c478259c014c81b6ec8a45c4c3e10f\\f18dad77d3f4ba8c594de9b3de4ce1a0\\__data",
  "rows": [
    {
      "row": 20,
      "speaker": "托鲁斯",
      "text": "嗯？　嗅嗅、嗅嗅……。\n特鲁鲁，对面好像飘来一股怪味啊。",
      "voice": "ch_10050/Main/1101/1101_10050_119",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "特鲁鲁",
      "text": "…………唔唔，确实。\n飘来一股闻不惯的味道汪。",
      "voice": "ch_10027/Main/1101/1101_10027_120",
      "command": ""
    },
    {
      "row": 50,
      "speaker": "奎娜",
      "text": "这是事件的气息！",
      "voice": "ch_10058/Main/1101/1101_10058_121",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "特鲁鲁",
      "text": "就是这样汪！\n戈什佩恩斯岛疯狗团，出动汪！",
      "voice": "ch_10027/Main/1101/1101_10027_122",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "萨拉",
      "text": "总觉得有种不祥的预感。\n艾瑠特，能陪我一起去吗？",
      "voice": "ch_10057/Main/1101/1101_10057_123",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "艾瑠特",
      "text": "说得也是。我对于卿卿我我还是管理都毫无兴趣。\n反正这座岛上有价值的东西，迟早全都是我的。\n主人，剩下的就由你收拾妥当吧。",
      "voice": "ch_10061/Main/1101/1101_10061_124",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "主人公",
      "text": "诶诶！？　这要求也太强人所难了……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "琳",
      "text": "那么，这样一来我和主人就是公认的情侣啦！\n我们去那边黏黏糊糊、卿卿我我吧～。",
      "voice": "ch_10006/Main/1101/1101_10006_125",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "克萝米",
      "text": "那么，主人就由我们来管理了。",
      "voice": "ch_10021/Main/1101/1101_10021_126",
      "command": ""
    },
    {
      "row": 82,
      "speaker": "赛莲",
      "text": "不要不要不要不要不要——————————！！",
      "voice": "ch_10023/Main/1101/1101_10023_127",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "铃",
      "text": "怎么这样，主人君！　我、我也想和你黏黏糊糊——哈！",
      "voice": "ch_10022/Main/1101/1101_10022_128",
      "command": ""
    },
    {
      "row": 108,
      "speaker": "铃",
      "text": "不是，我不是那个意思……也听听主人君的意见吧！",
      "voice": "",
      "command": ""
    },
    {
      "row": 109,
      "speaker": "铃",
      "text": "呐，主人君！？",
      "voice": "ch_10022/Main/1101/1101_10022_129",
      "command": ""
    },
    {
      "row": 110,
      "speaker": "主人公",
      "text": "啊哈哈，没关系的。\n反正我说什么也拦不住你们吧……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 127,
      "speaker": "琳",
      "text": "诶！？　主人不是说好要和我一起，\n期待黏腻腻的甜蜜新婚生活吗？\n初夜还说好要在史莱姆床上一起融化交融的吧？",
      "voice": "ch_10006/Main/1101/1101_10006_130",
      "command": ""
    },
    {
      "row": 128,
      "speaker": "铃",
      "text": "这擅自的前提认定是什么……！？",
      "voice": "ch_10022/Main/1101/1101_10022_131",
      "command": ""
    },
    {
      "row": 129,
      "speaker": "弗兰茜",
      "text": "本公主也一直认定，主人肯定是那种\n喜欢被束缚、被管理的类型。",
      "voice": "ch_10014/Main/1101/1101_10014_132",
      "command": ""
    },
    {
      "row": 130,
      "speaker": "铃",
      "text": "这边也……。",
      "voice": "ch_10022/Main/1101/1101_10022_133",
      "command": ""
    },
    {
      "row": 134,
      "speaker": "弗兰茜",
      "text": "既然如此，本公主再问主人一次。\n呐……被温柔地束缚，被甜蜜地、严厉地、\n彻底地管理的生活……不是很美妙吗？",
      "voice": "ch_10014/Main/1101/1101_10014_134",
      "command": ""
    },
    {
      "row": 138,
      "speaker": "琳",
      "text": "才没有呢。整个人埋进史莱姆里，\n在喜欢的时刻、做喜欢的事、想做多少就做多少的生活才好，\n你以前是这么说的呀～。",
      "voice": "ch_10006/Main/1101/1101_10006_135",
      "command": ""
    },
    {
      "row": 143,
      "speaker": "主人公",
      "text": "诶？　那个……、\n嗯、那个……我呢……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 152,
      "speaker": "铃",
      "text": "（咕咚……）",
      "voice": "ch_10006/Main/1101/1101_10006_136",
      "command": ""
    },
    {
      "row": 153,
      "speaker": "主人公",
      "text": "我、我想和大家好好相处！\n色色的事先放一边，让我们从互相了解开始！\n……这样不行吗……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 161,
      "speaker": "铃",
      "text": "（心动～～～～～）",
      "voice": "ch_10006/Main/1101/1101_10006_139",
      "command": ""
    },
    {
      "row": 166,
      "speaker": "弗兰茜",
      "text": "听你这么说，本公主再也按捺不住了！",
      "voice": "ch_10014/Main/1101/1101_10014_142",
      "command": ""
    },
    {
      "row": 172,
      "speaker": "琳",
      "text": "主人可是我的未婚夫呢～！\n不过算了，大家一起抱抱吧。",
      "voice": "ch_10006/Main/1101/1101_10006_143",
      "command": ""
    },
    {
      "row": 173,
      "speaker": "铃",
      "text": "诶、那个……哇，我也，只是抱一下的话！",
      "voice": "ch_10022/Main/1101/1101_10022_144",
      "command": ""
    },
    {
      "row": 179,
      "speaker": "主人公",
      "text": "哇、哇哇哇，等一下！\n好难受啊、好痒……、\n喂，你们在摸哪里啊！？　啊、呀啊啊！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 211,
      "speaker": "",
      "text": "魔物娘们朝主人公一拥而上。\n被推挤揉捏着、承受着若无其事的色色举动的主人公，\n薇薇神正满面笑容地守护着他。",
      "voice": "",
      "command": ""
    },
    {
      "row": 213,
      "speaker": "主人公",
      "text": "别光看着啊，快救救我呀！？",
      "voice": "",
      "command": ""
    }
  ]
}
