{
  "scenario_id": "10023c0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10023/10023c0_nml.book.asset",
  "cache_bundle": "D:\\mms\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\99ec179f7e1e0601fc4da3a60c9674fe42a2177081378b3355fd2cb963649857\\99ec179f7e1e0601fc4da3a60c9674fe\\__data",
  "rows": [
    {
      "row": 20,
      "speaker": "",
      "text": "モンスター娘に首根っこを掴まれた私は、\nゴミのように粗末に扱われ、砂浜に投げ捨てられた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "セレン",
      "text": "ここならいいだろ。\nご主人の教育に悪いところは、見せない方がいいからな。",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_001",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "セレン",
      "text": "おい敗北者。\nとっととそこに正座しろ正座。",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_002",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "地味魔導師",
      "text": "なっ、どうして正座しないといけないんです！？",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_003",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "地味魔導師",
      "text": "私、善良で勤勉な魔導師なんですよ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "ロッド",
      "text": "クギョウ！　クギョウ！　アシイタイ！",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_004",
      "command": ""
    },
    {
      "row": 56,
      "speaker": "セレン",
      "text": "……お前、なんで連れてこられたか分かってんのか？\n自分が悪いっていう認識あんのか？　反省してんのか？",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_005",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "セレン",
      "text": "その良く回る舌で、自分がしたことを説明してみろ。",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_006",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "地味魔導師",
      "text": "え、ええ……？\n私はお金が欲しいので、\n賞金首をひっとらえて換金しようとしただけですけど……？",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_007",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "ロッド",
      "text": "ナリワイ！　ナリワイムザイ！",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_008",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "セレン",
      "text": "私たちはともかくとして、だ。\nお前の目から見て、\nご主人が賞金がかかるような悪い人間に見えんのか？",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_009",
      "command": ""
    },
    {
      "row": 65,
      "speaker": "地味魔導師",
      "text": "え……？　そんなこと、何か関係があります？\n私はお金になれば興味ないですけど……？",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_010",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "ロッド",
      "text": "チャンスナノカ……？",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_011",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "地味魔導師",
      "text": "あっ、もしかして知っていればお金になるんですか？",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_012",
      "command": ""
    },
    {
      "row": 70,
      "speaker": "ロッド",
      "text": "イナ！　テッパン！",
      "voice": "en_49067/R18/10023C0_49067_Nml/10023C0_49067_013",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "セレン",
      "text": "……もういい、分かった。\nお前が金しか見てない、ダメな人間だってことが良く分かったよ。",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_014",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "セレン",
      "text": "それにそのバカ杖をバディにしてんのもダメだ。\nお前には別の……",
      "voice": "ch_10023/R18/10023C0_10023_Nml/10023C0_10023_015",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "セレン",
      "text": "もっといい相棒を紹介してやる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 108,
      "speaker": "",
      "text": "モンスター娘が好戦的な笑みを浮かべ、ゆっくりと迫ってくる。\nその異様な雰囲気に危険を感じながらも、\n私は足を動かすことができないのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
