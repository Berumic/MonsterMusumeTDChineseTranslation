{
  "scenario_id": "10351a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10351/10351a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\8b825dc5f6b8ff470a959ca045df5f4de71fe365f4959b8ec660c971564a93d8\\8b825dc5f6b8ff470a959ca045df5f4d\\__data",
  "rows": [
    {
      "row": 15,
      "speaker": "",
      "text": "僕はファロリエットさんに手を引かれ、\nビーチにまでやってきていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "ファロリエット水着",
      "text": "ほらほら、ご主人様ぁ！\n早く早くっ！",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_001",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "主人公",
      "text": "わ、ま、待ってくださいっ！",
      "voice": "",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "ファロリエット水着",
      "text": "せっかくの貸し切りだから、\nたくさん楽しまないと損だよぉ。",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_002",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "",
      "text": "普段は誰かしらがいるビーチだけれど、\n今日はまだ誰もいない。<interval=0.4>",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "",
      "text": "僕たちは真新しい砂浜に足跡をつけていく。",
      "voice": "",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "主人公",
      "text": "なんか、不思議な感じですね。\n誰もいないなんて、こんなこと殆どないのに……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "ファロリエット水着",
      "text": "きっと、優しくて美しくて偉大な獣神、\nファロルーチェ様が、おねショタを深めろって言ってるんだよぉ。",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_003",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "ファロリエット水着",
      "text": "だから、ご主人様は今日は私と、\nずーっといちゃいちゃするのが義務なんだよぉ！",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_004",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "ファロリエット水着",
      "text": "とりあえず……どうかなぁ、この水着！\nご主人様の為に用意したんだよぉ？",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_005",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "ファロリエット水着",
      "text": "豪華さと慎ましさ！\nそして色気と無垢な愛らしさ！\n私の魅力にご主人様もメロメロでしょ～？",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_006",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "主人公",
      "text": "は、はい。\nすごく可愛らしいと思います。",
      "voice": "",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "ファロリエット水着",
      "text": "でしょでしょ～？\nご主人様も、ちょっと触ってみるぅ？",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_007",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "主人公",
      "text": "えっ！？\nい、いや、そんなの失礼ですし……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "ファロリエット水着",
      "text": "失礼って、私、ただのモンスター娘だよぉ？\nただのファロルーチェ様の親戚の親戚の親戚だからぁ♪",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_008",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "",
      "text": "僕は女性に対して触るのが失礼と言ったつもりだったんだけど、\nファロリエットさんは少し勘違いしたみたいで、",
      "voice": "",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "",
      "text": "僕の手を掴んで",
      "voice": "",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "",
      "text": "腰に手を回させてきた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "ファロリエット水着",
      "text": "どお？　良い肌触りでしょぉ？\nやみつきになっちゃうでしょ～♪",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_009",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "主人公",
      "text": "は、はい……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 80,
      "speaker": "",
      "text": "ファロリエットさんは僕の手を掴んだまま、\n水着の上に手を滑らせる。\nその手触りは、確かにすごく気持ちよかった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 81,
      "speaker": "ファロリエット水着",
      "text": "ふふふ……焦らなくていいよ？\n今日は誰も邪魔しに来ないから。\nビビもいないし……ずっと二人っきりだよぉ。",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_010",
      "command": ""
    },
    {
      "row": 94,
      "speaker": "ファロリエット水着",
      "text": "とりあえず準備運動から始めよっか。\n準備運動はちゃーんとやらないとだめだよぉ？",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_011",
      "command": ""
    },
    {
      "row": 95,
      "speaker": "ファロリエット水着",
      "text": "ご主人様が怪我でもしちゃったら、\n私も悲しいもん！",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_012",
      "command": ""
    },
    {
      "row": 96,
      "speaker": "主人公",
      "text": "そうですね、足をつらないように、\nしっかり準備運動しましょう！",
      "voice": "",
      "command": ""
    },
    {
      "row": 97,
      "speaker": "",
      "text": "僕は頷き、体操を始める。",
      "voice": "",
      "command": ""
    },
    {
      "row": 104,
      "speaker": "",
      "text": "けれど、ファロリエットさんは、",
      "voice": "",
      "command": ""
    },
    {
      "row": 108,
      "speaker": "",
      "text": "少し不満なようで……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 109,
      "speaker": "ファロリエット水着",
      "text": "ご主人様、それじゃあ十分に体がほぐせないよぉ？",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_013",
      "command": ""
    },
    {
      "row": 110,
      "speaker": "主人公",
      "text": "え、そうですか？\nうーん……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 111,
      "speaker": "ファロリエット水着",
      "text": "ここは私に――ファロリエットお姉ちゃんに任せなさい♪",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_014",
      "command": ""
    },
    {
      "row": 117,
      "speaker": "主人公",
      "text": "えっ、わあ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 118,
      "speaker": "",
      "text": "ファロリエットさんは得意げに言うと、",
      "voice": "",
      "command": ""
    },
    {
      "row": 120,
      "speaker": "",
      "text": "なぜか僕に抱きついてきた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 121,
      "speaker": "ファロリエット水着",
      "text": "ご主人様の固くなってるところ、\nお姉ちゃんがじっくりほぐしてあげますからねぇ～。",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_015",
      "command": ""
    },
    {
      "row": 123,
      "speaker": "主人公",
      "text": "わっ！？　く、くすぐったいです……！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 124,
      "speaker": "ファロリエット水着",
      "text": "もー、暴れないの。\n抵抗してたら、変なところ、触っちゃうよぉ？",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_016",
      "command": ""
    },
    {
      "row": 125,
      "speaker": "ファロリエット水着",
      "text": "んふふ、安心して。\nお姉ちゃんに全部任せておけば大丈夫だからぁ。",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_017",
      "command": ""
    },
    {
      "row": 126,
      "speaker": "ファロリエット水着",
      "text": "ああ、ご主人様の肌すべすべぇ～。\n腕も腰も、細くて可愛いよぉ～。",
      "voice": "ch_10351/R18/10351A0_10351_Nml/10351A0_10351_018",
      "command": ""
    },
    {
      "row": 127,
      "speaker": "",
      "text": "ファロリエットさんは有無を言わさず、",
      "voice": "",
      "command": ""
    },
    {
      "row": 129,
      "speaker": "",
      "text": "体ごと、ごしごしこすりつけてくる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 130,
      "speaker": "",
      "text": "これが準備運動と呼べるのか分からないけれど……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 132,
      "speaker": "",
      "text": "でも、そのおかげか、一日中遊び続けても、\n足をつったり、怪我をしたりせずに済んだのだった",
      "voice": "",
      "command": ""
    }
  ]
}
