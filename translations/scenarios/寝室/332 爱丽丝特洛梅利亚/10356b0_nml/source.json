{
  "scenario_id": "10356b0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10356/10356b0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\2012bb0b60fc619bfafb8771f1bbc6c31490806e04705c546d5023a911268343\\2012bb0b60fc619bfafb8771f1bbc6c3\\__data",
  "rows": [
    {
      "row": 9,
      "speaker": "",
      "text": "その日、僕が見回りから部屋に戻ると、ウィッチさんがいた。\n机に陣取り、分厚い魔導書を広げている。帽子を少し持ち上げ、\n指先でページをめくる姿は、ずいぶん馴染んでいるように見えた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "主人公",
      "text": "ウィッチさん、どうして僕の部屋に。",
      "voice": "",
      "command": ""
    },
    {
      "row": 11,
      "speaker": "ウィッチもんくえ",
      "text": "読書よ。静かな場所を探していたの。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_001",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "",
      "text": "当然のように言われてしまう。",
      "voice": "",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "主人公",
      "text": "まぁ、いいですけど……おやつ、食べますか。",
      "voice": "",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "",
      "text": "机の上に焼きイモを置く。\n湯気が立ち、香ばしい甘い匂いが広がると、\nウィッチさんがふいに視線を上げた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "ウィッチもんくえ",
      "text": "イモ？",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_002",
      "command": ""
    },
    {
      "row": 16,
      "speaker": "主人公",
      "text": "焼きイモです。読書のお供にどうぞ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "",
      "text": "ウィッチさんの顔が曇った。",
      "voice": "",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "ウィッチもんくえ",
      "text": "イモ……！？\nまさか、またアイツの影響じゃないでしょうね。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_003",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "主人公",
      "text": "アイツ？",
      "voice": "",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "ウィッチもんくえ",
      "text": "サキュバス村の村長よ。あのイモびいき、何かにつけて\nイモを持ち上げて、\"イモは世界を救う\"なんて言うのよ。\nまったく、イモごときに惑わされるなんて、少年も染まったのね。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_004",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "主人公",
      "text": "いや、ただの焼きイモですけど……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 28,
      "speaker": "",
      "text": "ウィッチさんは腕を組み、顔をそむけた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 29,
      "speaker": "主人公",
      "text": "食べませんか。",
      "voice": "",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "ウィッチもんくえ",
      "text": "食べないわ。私はイモに踊らされるつもりはないの。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_005",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "主人公",
      "text": "おいしいですから、騙されたと思って食べてください。",
      "voice": "",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "ウィッチもんくえ",
      "text": "騙されたくない。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_006",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "",
      "text": "帽子をバサッと揺らし、ぷんすかと怒る。\nここまで頑なに拒否されるとは思わなかった。\n困った僕は、考えた末に切り札を出す。",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "主人公",
      "text": "じゃあ、ティーレさんおすすめの珍しい魔導書、\n差し上げますから。",
      "voice": "",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "",
      "text": "ウィッチさんの指がピクリと動く。",
      "voice": "",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "ウィッチもんくえ",
      "text": "……珍しい魔導書？",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_007",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "主人公",
      "text": "はい。ダークエルフ娘さんたちの間でも\n１冊しかなかった貴重なものです。どうでしょう。",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "",
      "text": "ウィッチさんが焼きイモをチラリと見た。",
      "voice": "",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "",
      "text": "少し悩んだ末、",
      "voice": "",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "",
      "text": "ため息をつく。",
      "voice": "",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "ウィッチもんくえ",
      "text": "……仕方ないわね。少年がそこまで言うなら。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_008",
      "command": ""
    },
    {
      "row": 56,
      "speaker": "",
      "text": "ようやく折れたらしい。焼きイモを手に取り、口へ運ぶ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "ウィッチもんくえ",
      "text": "……あーん。はむっ……もぐもぐ……ごっくん。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_009",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "主人公",
      "text": "味はどうですか。",
      "voice": "",
      "command": ""
    },
    {
      "row": 60,
      "speaker": "ウィッチもんくえ",
      "text": "……わからないわ。\nだって飲み込んじゃったから。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_010",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "主人公",
      "text": "えぇ……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "ウィッチもんくえ",
      "text": "ほら、食べるのに集中しても仕方ないでしょ。\nさっさと済ませて、魔導書を受け取るほうが効率的だもの。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_011",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "主人公",
      "text": "いやいや、味わう気ゼロじゃないですか。",
      "voice": "",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "",
      "text": "ウィッチさんは気にした様子もなく、手を差し出す。",
      "voice": "",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "ウィッチもんくえ",
      "text": "それより、魔導書。",
      "voice": "ch_10356/R18/10356B0_10356_Nml/10356B0_10356_012",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "",
      "text": "目の前のウィッチさんは、まるで取引を成立させた商人のように\n満足げだ。焼きイモを受け取ってもらったはずなのに、\nなぜか僕は敗北した気分だった。",
      "voice": "",
      "command": ""
    }
  ]
}
