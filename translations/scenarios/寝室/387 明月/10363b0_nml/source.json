{
  "scenario_id": "10363b0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10363/10363b0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\e06cd31e3e20bb68c191fb85fb0a47171c92197ea446bfddd6e65050139d8625\\e06cd31e3e20bb68c191fb85fb0a4717\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "森の中、小道の先で何かがふわっと揺れた。<interval=0.4>\n柔",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "",
      "text": "らかそうな金色の尻尾だった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 11,
      "speaker": "ミンユエ",
      "text": "ねえ、ご主人さん。\n“猫のしっぽ祈願”って、知ってる？",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_001",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "",
      "text": "急に現れたミンユエさんが、こちらを見上げてくる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 16,
      "speaker": "ミンユエ",
      "text": "金華猫のしっぽにそっと願いをかけるとね、\nその願いが叶うのよ。",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_002",
      "command": ""
    },
    {
      "row": 17,
      "speaker": "ミンユエ",
      "text": "あたしのは特別、月の光をいっぱい吸ってるから。\nだから、効果もバツグンってわけ。",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_003",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "主人公",
      "text": "そんな話、初耳ですけど……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 21,
      "speaker": "ミンユエ",
      "text": "あたしがさっき作った話だもの。",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_004",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "主人公",
      "text": "そんな堂々と言うことですか！",
      "voice": "",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "ミンユエ",
      "text": "でもいいでしょ？\n叶うかどうかより、信じる気持ちが大事なのよ。",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_005",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "",
      "text": "勝手に作った伝承を当然のように語るあたり、\nさすがミンユエさんだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 28,
      "speaker": "ミンユエ",
      "text": "さあ、ご主人さん。\nしっぽ、ここに差し出すから。\nお願いごと、ちゃんと込めて？",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_006",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "",
      "text": "ミンユエさんはくるんと回って、\nふわふわのしっぽを僕の胸元に差し出した。\n月明かりを浴びたその毛並みは、本当に綺麗だった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "ミンユエ",
      "text": "いい？　先っぽだけよ？　先っぽだけだからね？",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_007",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "主人公",
      "text": "……なんですか、その念の押し方は……。\nではちょっと、失礼して。",
      "voice": "",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "",
      "text": "僕がそっとしっぽに触れると、",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "ミンユエ",
      "text": "<size=40>ひゃっ！？",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_008",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "",
      "text": "ミンユエさんの声が跳ねた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "ミンユエ",
      "text": "ちょ、ちょっと！ そんなに急に触らないでよ！\nくすぐったいってばぁ……！",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_009",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "主人公",
      "text": "そ、そんなこと言われても……。\nくすぐったいなら止めましょうか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 50,
      "speaker": "ミンユエ",
      "text": "う……止めないで……だって、ご主人さんの願い、\nちゃんと叶えてあげたいし……。",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_010",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "ミンユエ",
      "text": "もうちょっとだけなら……んんっ……ふぅっ……にゃん♪",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_011",
      "command": ""
    },
    {
      "row": 54,
      "speaker": "",
      "text": "ミンユエさんがだんだん腰をくねらせ始める。\nこっちもどうしていいか分からなくなってきた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "ミンユエ",
      "text": "な、撫ですぎなんじゃない？\nなんか、しっぽの芯までビリビリしてきたんだけど……！",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_012",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "主人公",
      "text": "じゃあ止めますね。",
      "voice": "",
      "command": ""
    },
    {
      "row": 60,
      "speaker": "ミンユエ",
      "text": "だ、だめっ、途中でやめられると……逆に、変な感じに……！\nうう、も、もう限界！",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_013",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "ミンユエ",
      "text": "今日は終了ーっ！\nあたしのしっぽ、ふにゃふにゃになっちゃう～～～っ！！",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_014",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "",
      "text": "ばっ、と逃げていくミンユエさん。\nあれだけ堂々と差し出してきたくせに、\n僕は呆れて",
      "voice": "",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "",
      "text": "溜息を吐いた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "",
      "text": "少し離れた木陰。\nそこにしゃがみ込んだ彼女が、\nしっぽをそっと撫でながら呟く。",
      "voice": "",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "ミンユエ",
      "text": "……でも、あなたの願い、ちゃんと叶うといいわね。\nふふ、ご主人さんだけの、特別よ？",
      "voice": "ch_10363/R18/10363B0_10363_Nml/10363B0_10363_015",
      "command": ""
    },
    {
      "row": 79,
      "speaker": "",
      "text": "風が木々を揺らし、月明かりがそっとしっぽを照らす中、\nミンユエさんはくすっと笑って目を細めた。\nその瞳は、ほんの少しだけ、いつもより優しかった。",
      "voice": "",
      "command": ""
    }
  ]
}
