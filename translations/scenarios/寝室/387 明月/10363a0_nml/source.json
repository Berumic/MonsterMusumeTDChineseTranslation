{
  "scenario_id": "10363a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10363/10363a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\a99820a6b3c586186654f30d5d9f017601bec8cc2ac2a95a8de943e55a583800\\a99820a6b3c586186654f30d5d9f0176\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "昼下がりの森の中、背後からふわりと柔らかな気配がして、\n僕はそっと振り返った。",
      "voice": "",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "ミンユエ",
      "text": "ご主人さん。\n今日のあたし、すっごくいいモノ見せてあげるわ。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_001",
      "command": ""
    },
    {
      "row": 17,
      "speaker": "ミンユエ",
      "text": "いい？　特別大サービスなんだから、\n泣きながら感謝してよね？",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_002",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "",
      "text": "ミンユエさんは、にこっと笑いながら\n僕の目の前に回り込んできた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "ミンユエ",
      "text": "あたしがね、あなたの“理想の美”になってあげる。\nその目でしっかり見てなさい？",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_003",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "",
      "text": "そう言うなり、彼女の姿が淡い光に包まれ、ふっと変わった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "",
      "text": "現れたのは──",
      "voice": "",
      "command": ""
    },
    {
      "row": 29,
      "speaker": "",
      "text": "どこかで見たことのある、\n幼い少女のような姿だった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "ファロリエット",
      "text": "どう？ この完璧な変身。\n可愛くて、美しくて、\nあたしってば最高すぎて困っちゃうわよね。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_004",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "主人公",
      "text": "……えっと。\nその姿、ファロリエットさんですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "ファロリエット",
      "text": "そうよ。これは、“ちっちゃくて美しい”を極めた究極形。\nサイズ感も表情も、完璧に計算して真似したんだから。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_005",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "ファロリエット",
      "text": "ご主人さんは、こーゆーの好きでしょ？　まさに理想でしょ？",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_006",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "主人公",
      "text": "いや、僕は別にそういうのが理想ってわけじゃ……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "ミンユエ",
      "text": "え？ そうなの？\nでもあたしのセンス、間違ってるわけないし。\nもしかして、あなたの感性がちょっと遅れてるんじゃない？",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_007",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "",
      "text": "ぐいっと顔を近づけてきて、\nミンユエさんはじとーっと僕を見つめる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "ミンユエ",
      "text": "……しょうがないわね、<interval=2>\nご主人さんには“特別バージョン”を見せてあげる。\n今度はもっと大人っぽくいくから、ちゃんと見てなさい？",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_008",
      "command": ""
    },
    {
      "row": 58,
      "speaker": "",
      "text": "再び光に包まれた彼女は、くるりと一回転して──。",
      "voice": "",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "ミンユエ",
      "text": "じゃーん！<interval=1.5>\nどう？ これが“少しオトナになったあたし”よ。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_009",
      "command": ""
    },
    {
      "row": 65,
      "speaker": "ミンユエ",
      "text": "驚いたでしょ？\n悶絶して失禁してもいいのよ？",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_010",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "主人公",
      "text": "そんなことしませんよっ！\nそれにしても見た目、あんまり変わってないような……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "ミンユエ",
      "text": "ちょっと！ 見てよ、このまつげのカール！\nあとね、スカートの裾も数ミリ長くしたんだから！",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_011",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "主人公",
      "text": "誤差の範囲では……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 74,
      "speaker": "ミンユエ",
      "text": "はぁ……まったく、やれやれね。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_012",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "ミンユエ",
      "text": "ご主人さんってば見る目なさすぎ。\nでもまあいいわ。\nそのうち、あたしの魅力に気づいて泣きついてくるんだから。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_013",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "",
      "text": "ミンユエさんは",
      "voice": "",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "",
      "text": "ふいっと背を向け、\nゆっくりと深呼吸したかと思うと、",
      "voice": "",
      "command": ""
    },
    {
      "row": 84,
      "speaker": "",
      "text": "ぱちんと指を鳴らした。",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "",
      "text": "次の瞬間、淡い光に包まれて、\n彼女は元の姿に戻っていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "ミンユエ",
      "text": "はい、元通り。\n魅力爆増のボーナスタイムは終了よ。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_014",
      "command": ""
    },
    {
      "row": 90,
      "speaker": "主人公",
      "text": "……やっぱり、いつものミンユエさんがいいと思いますよ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "ミンユエ",
      "text": "えっ……。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_015",
      "command": ""
    },
    {
      "row": 93,
      "speaker": "",
      "text": "僕が素直にそう口にすると、\nミンユエさんは一瞬きょとんとした顔を見せたあと、\n照れ隠しのようにそっぽを向いてしまった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 111,
      "speaker": "ミンユエ",
      "text": "……そういうの、ずるい。",
      "voice": "ch_10363/R18/10363A0_10363_Nml/10363A0_10363_016",
      "command": ""
    },
    {
      "row": 113,
      "speaker": "",
      "text": "耳のあたりが少し赤くなっていたことは、\n僕だけの秘密にすることにしたのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
