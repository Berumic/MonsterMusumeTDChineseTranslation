{
  "scenario_id": "10361a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10361/10361a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\0b495c3bc450bc7fb20465d404a1bfc8fa1203bf126f7136dfa866c7f389ebb1\\0b495c3bc450bc7fb20465d404a1bfc8\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "ある日、森の中で演奏会の準備をしていると、\nどこからかやたら高いテンションの声が飛んできた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "ナーダ",
      "text": "ご主人さーん！ 大変なのぉ！\nわたし、音が出せなくなっちゃったかもぉ〜！",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_001",
      "command": ""
    },
    {
      "row": 9,
      "speaker": "主人公",
      "text": "……ナーダさん、楽器壊したんですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "ナーダ",
      "text": "ちがうのぉ！ シタールは元気なの。\nでも、わたしの音穴が反応しなくてぇ……。",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_002",
      "command": ""
    },
    {
      "row": 11,
      "speaker": "主人公",
      "text": "音穴って言い方、なんか危ないんでやめてもらえますか。",
      "voice": "",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "",
      "text": "ナーダさんは、両手でシタールを抱えて困った顔をする。  ",
      "voice": "",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "",
      "text": "その直後、なぜかこちらに楽器を差し出してきた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "ナーダ",
      "text": "ねぇ、ご主人さん。なでなでしてみて？ 音が鳴るかも〜♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_003",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "主人公",
      "text": "いや、僕は修理屋じゃないんですけど。",
      "voice": "",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "ナーダ",
      "text": "いいからぁ〜♪\nここ、撫でて……あっ、ちょっと振動きたかも♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_004",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "",
      "text": "ナーダさんの反応がいやに生々しい。\nこれはもう、間違ってる方向にしか聞こえない。",
      "voice": "",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "主人公",
      "text": "落ち着いて。そもそもどこから音が出ないんです？",
      "voice": "",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "ナーダ",
      "text": "うーんとね〜、たぶん……ここ！",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_005",
      "command": ""
    },
    {
      "row": 30,
      "speaker": "",
      "text": "ナーダさんは自分のお腹をポンと叩いた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "主人公",
      "text": "……それ、あなたの腹の虫じゃないですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "ナーダ",
      "text": "えっ！？ あ、ホントだ……グーっていってるぅ〜！",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_006",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "主人公",
      "text": "つまり、音が出なかったのは腹ペコのせい……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "ナーダ",
      "text": "ち、ちがうの！ でも、そうかも？ \n……ご主人さんのナデナデが気持ちよくてぇ、\n舞に夢中でごはん忘れたぁ♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_007",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "",
      "text": "そもそも音が出ない原因が演奏じゃなくて空腹って、\nどういうことなんだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "ナーダ",
      "text": "でもでも、いま少し出たよぉ？\nちょっとさすってくれたからぁ〜♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_008",
      "command": ""
    },
    {
      "row": 39,
      "speaker": "主人公",
      "text": "……あの、それ、ただのゲップじゃないですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "ナーダ",
      "text": "うそ！？　わたし、音じゃなくてゲップしてたの！？\n……恥ずかしっ♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_009",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "主人公",
      "text": "ナーダさん、音楽の前に生活を整えましょう。",
      "voice": "",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "ナーダ",
      "text": "うぅ〜……ご主人さんが撫でるからぁ〜。\n責任とって、わたしの音探してぇ♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_010",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "主人公",
      "text": "せめて表現だけでも真面目にしてください……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "",
      "text": "そのとき、ふとナーダさんが、",
      "voice": "",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "",
      "text": "何かを思い出したように指を鳴らした。",
      "voice": "",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "ナーダ",
      "text": "そうだぁ〜！　ご主人さん、シタールの弦、\nちょっと張りすぎてるのかもぉ！",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_011",
      "command": ""
    },
    {
      "row": 54,
      "speaker": "主人公",
      "text": "だから音が出ないんじゃなくて、出るけど音割れしてる感じ？",
      "voice": "",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "ナーダ",
      "text": "うん、でも弾いてみて？\nわたしの後ろで♪　ほら、背中にぴったりくっついてぇ〜。",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_012",
      "command": ""
    },
    {
      "row": 56,
      "speaker": "主人公",
      "text": "……え、背中越しに弾くんですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "ナーダ",
      "text": "うん、密着したら共鳴しやすくなるって聞いたのぉ〜♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_013",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "",
      "text": "言いながらナーダさんは自分の背中をこちらに",
      "voice": "",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "",
      "text": "押し付ける。\nなにがどうしてこうなるのか、もはや謎だった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 70,
      "speaker": "",
      "text": "僕は仕方なく楽器を手に取り、\n後ろからそっと奏でてみると──。",
      "voice": "",
      "command": ""
    },
    {
      "row": 73,
      "speaker": "ナーダ",
      "text": "……出たぁ♪　ご主人さんと一緒だと、\nすっごく気持ちよく出るぅ〜！",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_014",
      "command": ""
    },
    {
      "row": 74,
      "speaker": "",
      "text": "僕としては、ナーダさんに、\nその言い方だけはどうにかしてほしかった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "",
      "text": "ナーダさんはくるりとこちらに振り返り、",
      "voice": "",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "",
      "text": "目を輝かせる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 84,
      "speaker": "ナーダ",
      "text": "じゃあ、これからもご主人さんが一緒に演奏してくれたら、\nわたし毎日出せるかも〜♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_015",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "主人公",
      "text": "……いろいろ誤解されそうなので\nもう少し真面目に音楽に向き合ってくださいよ……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "ナーダ",
      "text": "でもぉ〜♪　ご主人さんと奏でると、\nココロもカラダも震えちゃうんだもん〜♪",
      "voice": "ch_10361/R18/10361A0_10361_Nml/10361A0_10361_016",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "",
      "text": "もう誰か、ナーダさんの騒ぎを静めてくれないだろうか、\n僕はそう、切実に願ったのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
