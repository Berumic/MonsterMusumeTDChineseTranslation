{
  "scenario_id": "10044b0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10044/10044b0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\1704bb4534dbc4c8f6697a88d69066857c510b6994d2cf8de894b937839aa92c\\1704bb4534dbc4c8f6697a88d6906685\\__data",
  "rows": [
    {
      "row": 11,
      "speaker": "ラゴス",
      "text": "おい、ご主人！　きゃわいいお前を\nただただ一方的に甘やかすのが最高だよな！？",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_001",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "主人公",
      "text": "はぁ……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "",
      "text": "ドタドタとけたたましく僕の部屋に入ってきたラゴスさんは、\n意味のわからない事を言いながら僕に詰め寄ってきた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "ラゴス",
      "text": "違うわよね！\n無垢なあなたに偏った知識を与えて、\n一から調教する事こそ至高よね！？",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_002",
      "command": ""
    },
    {
      "row": 17,
      "speaker": "ラゴス",
      "text": "そんなの、おかしいです……！\n普段おどおどしたご主人さまが、\nここぞと言う時に強気な攻めに転じるのがイイんですよね……！？",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_003",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "主人公",
      "text": "えーっと……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "",
      "text": "「ですよね」とか言われても正直困る。\nまさかそんなくだらない話題で、\n人格間で喧嘩をすることの方が驚きだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "ラゴス",
      "text": "ご主人の意見を聞かせてくれ！\nどんな接し方をされたら嬉しい！？\n正直に頼む！　オレの好みと違っても怒らないから！",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_004",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "主人公",
      "text": "うーん……。\n正直、どうでもいいですねぇ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "ラゴス",
      "text": "<size=40>あぁん！？！？</size>",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_005",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "ラゴス",
      "text": "なんだァ？　てめェ……。",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_006",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "主人公",
      "text": "お、怒らないって言ったじゃないですか！",
      "voice": "",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "",
      "text": "一体、何が彼女の逆鱗に触れてしまったのだろうか。　\nラゴスさんの怒る理由が分からず、咄嗟に言い訳を考えていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 47,
      "speaker": "ラゴス",
      "text": "屋上へ行こうぜ……久しぶりに……キレちまったよ……。",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_007",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "主人公",
      "text": "ちょ、ちょっと落ち着いてください！\nどうでもいいっていうのは、軽んじているわけではなくて……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 49,
      "speaker": "主人公",
      "text": "えっと、その……僕はラゴスさんにだったら、\nどんな接し方をされても、きっと、嬉しい……ですから。",
      "voice": "",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "ラゴス",
      "text": "……！",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_008",
      "command": ""
    },
    {
      "row": 65,
      "speaker": "",
      "text": "自分でも恥ずかしいことを言っている自覚があるため、\nつい、たどたどしい物言いになってしまった。\nそれがさらに羞恥心を煽り、顔がどんどん熱くなっていく。",
      "voice": "",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "ラゴス",
      "text": "……しゅき。",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_009",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "主人公",
      "text": "え？　わわっ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 73,
      "speaker": "",
      "text": "急にラゴスさんに抱きしめられた。\n顔と顔をすりすりと高速で擦り合わせてくる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "ラゴス",
      "text": "はぁーご主人！　可愛すぎだぜ！",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_010",
      "command": ""
    },
    {
      "row": 81,
      "speaker": "ラゴス",
      "text": "しゅきしゅきしゅきぃ♪　もう離さないっ！",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_011",
      "command": ""
    },
    {
      "row": 82,
      "speaker": "",
      "text": "あまりに強く抱きしめられて、\n息がうまくできないばかりか、言葉をうまく発せられない。",
      "voice": "",
      "command": ""
    },
    {
      "row": 84,
      "speaker": "ラゴス",
      "text": "えへ、えへへへ……。\nご主人さまとなら何でも嬉しいです……！",
      "voice": "ch_10044/R18/10044B0_10044_Nml/10044B0_10044_012",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "主人公",
      "text": "(そうですか、それはなによりです……）",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "",
      "text": "言おうと思っても、強力な抱擁で言葉が吐けない。\nこれほど強く想ってくれているのだと、嬉しく感じながら\n僕の意識は遠く霞んでいったのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
