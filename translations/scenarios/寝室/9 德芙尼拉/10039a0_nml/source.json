{
  "scenario_id": "10039a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10039/10039a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\1c071042b894db8c3dab36d859e73402395df9330fcbb5f8db97357eb6081820\\1c071042b894db8c3dab36d859e73402\\__data",
  "rows": [
    {
      "row": 9,
      "speaker": "モンスター",
      "text": "<size=40>ギャォォォオオッ！！</size>",
      "voice": "",
      "command": ""
    },
    {
      "row": 10,
      "speaker": "主人公",
      "text": "ひ……っ！　た、助け……っ！",
      "voice": "",
      "command": ""
    },
    {
      "row": 11,
      "speaker": "",
      "text": "森に採集に来た僕は、\n草むらから突如現れた巨大なモンスターに襲われた。\nそいつは大きな口を開け、今にも僕に嚙みつかんとしている。",
      "voice": "",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "",
      "text": "逃げようにも、恐怖のあまり体が動かない。",
      "voice": "",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "",
      "text": "いよいよ死を覚悟し、僕はギュッと目を閉じた。\nその時――。",
      "voice": "",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "？？？",
      "text": "えいっ。",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_001",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "",
      "text": "鋭い金属音が聞こえ、ずぅん……と重い音が響いた。\n僕は恐る恐る目を開ける。",
      "voice": "",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "ディフニラ",
      "text": "こんな雑魚にビビりすぎだよ。\nまったく、もっとしっかりしてよね。",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_002",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "",
      "text": "とても雑魚とは思えないモンスターが、地に伏して沈黙していた。\nディフニラさんが、一撃で倒したのだろう。\n安堵と感謝で、思わず涙が出た。",
      "voice": "",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "主人公",
      "text": "あぅぁ～、ディフニラしゃん……。\nありがとうごじゃいましゅ……！",
      "voice": "",
      "command": ""
    },
    {
      "row": 36,
      "speaker": "ディフニラ",
      "text": "泣いちゃって、情けないなぁ。\nほら、行くよ。",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_003",
      "command": ""
    },
    {
      "row": 37,
      "speaker": "",
      "text": "涙をぬぐい、立ち上がろうとする。\nしかし、腰が抜けてしまって力が入らなかった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 38,
      "speaker": "主人公",
      "text": "あ、あの……すみません、腰が抜けちゃって……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 49,
      "speaker": "ディフニラ",
      "text": "はぁ、しょうがないなぁ……。\nほら、掴まって。",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_004",
      "command": ""
    },
    {
      "row": 54,
      "speaker": "",
      "text": "彼女から差し出された手を掴む。\nディフニラさんは、さして力を入れる様子もなく、\n軽々と僕を引き上げてくれたのだが。",
      "voice": "",
      "command": ""
    },
    {
      "row": 56,
      "speaker": "ディフニラ",
      "text": "きゃんっ！",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_005",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "",
      "text": "勢い余って、ディフニラさんにぶつかってしまった。\nその時、僕の手が彼女の胸に触れた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 60,
      "speaker": "主人公",
      "text": "すっ、すすすす、すみませんっ！",
      "voice": "",
      "command": ""
    },
    {
      "row": 61,
      "speaker": "ディフニラ",
      "text": "…………聞いた？",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_006",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "主人公",
      "text": "え？　「きゃんっ！」って反応の事ですか？\n可愛いお声でしたね。",
      "voice": "",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "",
      "text": "ディフニラさんは、俯きながらワナワナと震えている。\nしまった。いじっていると思われただろうか。",
      "voice": "",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "ディフニラ",
      "text": "殺す……！",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_007",
      "command": ""
    },
    {
      "row": 74,
      "speaker": "",
      "text": "そう言って、彼女は顔を真っ赤にしながら僕に襲い掛かった。\nすんでの所で避け、僕は逃げ出す。",
      "voice": "",
      "command": ""
    },
    {
      "row": 76,
      "speaker": "ディフニラ",
      "text": "待てっ！\n脳みそ引きずり出して全てを忘れさせてやる……っ！",
      "voice": "ch_10039/R18/10039A0_10039_Nml/10039A0_10039_008",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "主人公",
      "text": "（怖っ！）",
      "voice": "",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "",
      "text": "こんなことを言われて、待つ人はいないだろう。\n僕は背後から向けられる\n凄まじい殺気を感じながら、懸命に走った。",
      "voice": "",
      "command": ""
    },
    {
      "row": 79,
      "speaker": "",
      "text": "掴まればヤバいと感じながらも、\n彼女の可愛らしい一面を知ってしまい、\n口元に笑みが浮かぶのをやめられなかったのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
