{
  "scenario_id": "10355a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10355/10355a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\bf1883ac7ca4f337e586fc35eedb378bc2ea5a8d8681cbca265865ba90b596fd\\bf1883ac7ca4f337e586fc35eedb378b\\__data",
  "rows": [
    {
      "row": 13,
      "speaker": "",
      "text": "海の見回りに来た僕は、砂浜の岩陰に立つエミリさんを見つけた。\n視線の先には……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "",
      "text": "スキュラ娘のルキュレさんが、\n波打ち際でのんびりと過ごしている。",
      "voice": "",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "主人公",
      "text": "エミリさん、どうしたんですか？\nルキュレさんをそんなに凝視して。",
      "voice": "",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "エミリもんくえ",
      "text": "あの子、なんかあたしに似てる気がするのよね。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_001",
      "command": ""
    },
    {
      "row": 34,
      "speaker": "主人公",
      "text": "似てる……？　ルキュレさんとエミリさんが？",
      "voice": "",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "エミリもんくえ",
      "text": "そうよ。あの触手の感じとか、雰囲気とか。\nほら、あたしの触手もなかなかいいでしょ。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_002",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "",
      "text": "エミリさんが自慢げに触手をくねらせる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "主人公",
      "text": "確かに共通点はありますね。\nでも、エミリさんのほうが……なんというか、\nアグレッシブというか……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 42,
      "speaker": "エミリもんくえ",
      "text": "当然よ。あたしはただの触手持ちじゃなくて、\n妖魔貴族の娘なんだから。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_003",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "",
      "text": "エミリさんがふふんと胸を張る。\nこういうところは貴族らしい……のかもしれない。",
      "voice": "",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "エミリもんくえ",
      "text": "でしょ。お母さまとも似てるし。\n気品があって落ち着いた雰囲気がそっくりよ。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_004",
      "command": ""
    },
    {
      "row": 46,
      "speaker": "主人公",
      "text": "なるほど……。も",
      "voice": "",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "主人公",
      "text": "しかしてお母さんに\n会いたいっていうホームシックですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 50,
      "speaker": "エミリもんくえ",
      "text": "違うわよ。あの子と仲良くなりたいなって。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_005",
      "command": ""
    },
    {
      "row": 51,
      "speaker": "",
      "text": "エミリさんがそんなことを言うのは少し意外だった。\nツンデレで気の強い彼女が、\n素直に誰かと仲良くなりたいと言うのは珍しい。",
      "voice": "",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "主人公",
      "text": "なら話しかけてみましょうよ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 54,
      "speaker": "エミリもんくえ",
      "text": "いいの？　でも、どうやって……。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_006",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "主人公",
      "text": "普通に挨拶すればいいと思いますよ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "エミリもんくえ",
      "text": "ふ、ふん……まぁ、それくらい簡単よ。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_007",
      "command": ""
    },
    {
      "row": 59,
      "speaker": "",
      "text": "エミリさんがやや緊張気味に前に出ようとした、\nその瞬間だった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "老魔導師",
      "text": "<size=40>ルキュレたーーーん！！！</size>",
      "voice": "",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "",
      "text": "砂浜の向こうから、甲高い声が響く。",
      "voice": "",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "",
      "text": "見ると、長いローブを着た男が",
      "voice": "",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "",
      "text": "猛スピードでこちらへ向かってくる。\n両腕を大きく振り、涙ぐみながら何かを叫んでいる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 78,
      "speaker": "老魔導師",
      "text": "おおおおおお、今日も美しい！　私の愛しき触手天使よ！",
      "voice": "",
      "command": ""
    },
    {
      "row": 79,
      "speaker": "主人公",
      "text": "また来た……老魔導師だ……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "",
      "text": "ルキュレさんは一瞬驚いたが、<interval=0.8>",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "",
      "text": "すぐに無表情になり、\n軽くため息をついた。<interval=1>そ",
      "voice": "",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "",
      "text": "して、何も言わずに触手を振りかぶり、",
      "voice": "",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "",
      "text": "突進してくる老魔導師の顔面に叩きつけた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 103,
      "speaker": "",
      "text": "バシンッ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 112,
      "speaker": "",
      "text": "老魔導師が吹っ飛び、砂浜に転がる。\n口元が緩んでいるのが気になるが、もっと気になるのは……。\n目を輝かせているエミリさんだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 114,
      "speaker": "エミリもんくえ",
      "text": "あの子、アイドルみたいにおっかけがいるんだ。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_008",
      "command": ""
    },
    {
      "row": 115,
      "speaker": "主人公",
      "text": "いやいや、あれはおっかけじゃなくてストーカー……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 116,
      "speaker": "エミリもんくえ",
      "text": "ふーん。この島では、おっかけを、\n触手でああやって遊んでいいんだ。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_009",
      "command": ""
    },
    {
      "row": 117,
      "speaker": "主人公",
      "text": "待って、それは違う……！",
      "voice": "",
      "command": ""
    },
    {
      "row": 118,
      "speaker": "エミリもんくえ",
      "text": "じゃあ、エミリ、あんたと遊んであげる。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_010",
      "command": ""
    },
    {
      "row": 122,
      "speaker": "主人公",
      "text": "いや、なんでですか！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 129,
      "speaker": "",
      "text": "エミリさんの触手がしゅるりと僕のほうへ伸びる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 130,
      "speaker": "エミリもんくえ",
      "text": "だって、あのおっかけ、触手で叩かれてうっとりしてたでしょ？\nあたしも気持ちよくしてあげるわ。",
      "voice": "ch_10355/R18/10355A0_10355_Nml/10355A0_10355_011",
      "command": ""
    },
    {
      "row": 131,
      "speaker": "主人公",
      "text": "絶対意味が違いますよね！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 132,
      "speaker": "",
      "text": "やばい。僕はとっさに砂浜を駆け出す。",
      "voice": "",
      "command": ""
    },
    {
      "row": 137,
      "speaker": "",
      "text": "後ろから、楽しそうに笑うエミリさんの声が聞こえた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 139,
      "speaker": "主人公",
      "text": "ルキュレさんと仲良くなりたいって言ってたのに、\nなんでこうなるんですかー！",
      "voice": "",
      "command": ""
    },
    {
      "row": 140,
      "speaker": "",
      "text": "僕の心からの叫びは、あの老魔導士にも負けないくらい、\n穏やかな砂浜に響き渡ったのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
