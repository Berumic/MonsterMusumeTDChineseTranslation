{
  "scenario_id": "10352a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10352/10352a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\f631cd3a13f412bd39c96ef01656c595bd33b6da685567aeb90d9462ad6ca007\\f631cd3a13f412bd39c96ef01656c595\\__data",
  "rows": [
    {
      "row": 11,
      "speaker": "主人公",
      "text": "さあ、ハイルィさん。思う存分遊びましょう。\nせっかくの海ですから。",
      "voice": "",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "",
      "text": "照りつける太陽の下、僕の目の前に立つのは、",
      "voice": "",
      "command": ""
    },
    {
      "row": 14,
      "speaker": "",
      "text": "水着姿のハイルィさんだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "ハイルィ水着",
      "text": "ショウネン。まさか、こんな格好で修行させる気か？",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_001",
      "command": ""
    },
    {
      "row": 19,
      "speaker": "",
      "text": "彼女は眉間にしわを寄せて、\nまるで敵を見るような目でこちらを睨んでいる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "主人公",
      "text": "いや、修行というか、今日はその……遊びに来たんですけど。",
      "voice": "",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "ハイルィ水着",
      "text": "ふむ。遊び。つまり戦闘訓練ではないと？",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_002",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "主人公",
      "text": "そうですね。",
      "voice": "",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "",
      "text": "腕を組み、",
      "voice": "",
      "command": ""
    },
    {
      "row": 45,
      "speaker": "",
      "text": "ふんっと鼻を鳴らす。",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "",
      "text": "その威圧感は水着姿でも",
      "voice": "",
      "command": ""
    },
    {
      "row": 62,
      "speaker": "",
      "text": "まったく変わらない。",
      "voice": "",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "ハイルィ水着",
      "text": "水辺で鍛えるならば、\nもっと布の多い装備が適しているはずだが……、\nこの水着とやら、布が少なすぎるぞ。",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_003",
      "command": ""
    },
    {
      "row": 70,
      "speaker": "主人公",
      "text": "たしかに少ないですね。でも、それが普通なんですよ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 71,
      "speaker": "",
      "text": "ハイルィさんは胸元をちらりと見下ろして、\n不満げに口を引き結ぶ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "ハイルィ水着",
      "text": "だいたい、こんなもので本当に泳げるのか？",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_004",
      "command": ""
    },
    {
      "row": 75,
      "speaker": "",
      "text": "そう言いながら、\nハイルィさんは水着の胸元を無造作に引っ張ってみせた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "主人公",
      "text": "ちょっ、ちょっと待ってください、それ引っ張ったら！",
      "voice": "",
      "command": ""
    },
    {
      "row": 79,
      "speaker": "ハイルィ水着",
      "text": "ふむ、なんだ。確認しているだけだが？",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_005",
      "command": ""
    },
    {
      "row": 80,
      "speaker": "主人公",
      "text": "い、いえ、そうなんですけど、\nちょっとその……見えちゃいそうで！",
      "voice": "",
      "command": ""
    },
    {
      "row": 82,
      "speaker": "ハイルィ水着",
      "text": "何を騒いでいる、ショウネン。\n水着とはこういうものではないのか？",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_006",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "主人公",
      "text": "そ、そうなんですけど、無防備すぎるというか……。\n<interval=1>目",
      "voice": "",
      "command": ""
    },
    {
      "row": 85,
      "speaker": "主人公",
      "text": "のやり場が！　そ、それにあの、それ、\n一応泳ぐための衣装なんですよ？",
      "voice": "",
      "command": ""
    },
    {
      "row": 86,
      "speaker": "",
      "text": "引っ張った拍子に、布がずれそうになっていて、\nあわや見えてしまいそうだった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "ハイルィ水着",
      "text": "ふむ……そうか。ならば、実践で試してみるか。",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_007",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "主人公",
      "text": "えっ、泳ぐんですか？ いや、いいんですけど……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 90,
      "speaker": "",
      "text": "そう言ったそばから、彼女は海に向かってズンズンと歩き出す。\nこっちの返事なんて関係ないらしい。",
      "voice": "",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "ハイルィ水着",
      "text": "ふっ。当然だ。修行ではないと言ったな？\nならば勝負だ、ショウネン！",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_008",
      "command": ""
    },
    {
      "row": 93,
      "speaker": "主人公",
      "text": "勝負って、ちょっと待って――",
      "voice": "",
      "command": ""
    },
    {
      "row": 95,
      "speaker": "主人公",
      "text": "……ああ、もう行っちゃった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 96,
      "speaker": "",
      "text": "そのまま沖まで泳ぎ出していく姿を追いながら、",
      "voice": "",
      "command": ""
    },
    {
      "row": 105,
      "speaker": "",
      "text": "僕も慌てて飛び込んだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 114,
      "speaker": "ハイルィ水着",
      "text": "ふっ、どうした。もう息が切れたのか？",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_009",
      "command": ""
    },
    {
      "row": 115,
      "speaker": "主人公",
      "text": "いや、早すぎますって！　そっちのが絶対慣れてるでしょ！",
      "voice": "",
      "command": ""
    },
    {
      "row": 116,
      "speaker": "",
      "text": "水しぶきを浴びせかけられて、\n完全におもちゃにされている気がする。",
      "voice": "",
      "command": ""
    },
    {
      "row": 118,
      "speaker": "ハイルィ水着",
      "text": "ふははっ♪　見たか、我の実力を。",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_010",
      "command": ""
    },
    {
      "row": 119,
      "speaker": "",
      "text": "ハイルィさんは余裕たっぷりに髪をかきあげ、\n満足げに海上を見渡していた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 120,
      "speaker": "",
      "text": "僕はというと、すっかり体力を奪われ、\n荒い呼吸を繰り返すばかりだ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 121,
      "speaker": "ハイルィ水着",
      "text": "さあ、もう一往復いくぞ、ショウネン！",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_011",
      "command": ""
    },
    {
      "row": 125,
      "speaker": "主人公",
      "text": "ま、待ってくださいってば……！",
      "voice": "",
      "command": ""
    },
    {
      "row": 126,
      "speaker": "",
      "text": "何度も挑んでは負け、息も絶え絶えの僕に、\n彼女は楽しげに笑っていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 133,
      "speaker": "",
      "text": "夕暮れが近づき、空が茜色に染まる頃、\nようやく二人して浜へと戻る。",
      "voice": "",
      "command": ""
    },
    {
      "row": 137,
      "speaker": "ハイルィ水着",
      "text": "む、なんだ。",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_012",
      "command": ""
    },
    {
      "row": 138,
      "speaker": "",
      "text": "陸に戻ると、\n彼女は突然自分の肩や胸元を見下ろして立ち止まる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 139,
      "speaker": "主人公",
      "text": "どうかしました？",
      "voice": "",
      "command": ""
    },
    {
      "row": 141,
      "speaker": "ハイルィ水着",
      "text": "やはりこの布の少なさ、落ち着かん……。",
      "voice": "ch_10352/R18/10352A0_10352_Nml/10352A0_10352_013",
      "command": ""
    },
    {
      "row": 144,
      "speaker": "主人公",
      "text": "<size=40>今さら！？</size>",
      "voice": "",
      "command": ""
    },
    {
      "row": 146,
      "speaker": "",
      "text": "顔を赤くしながら腕を抱いて背を向けるその姿は、\nいつもの威厳とは少し違って見えたのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
