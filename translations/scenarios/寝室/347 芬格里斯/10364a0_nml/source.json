{
  "scenario_id": "10364a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10364/10364a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\f9953fd33bd630c7faea8ecc6a452b5e63791df74a83cac2857ef34b2d9cb1f1\\f9953fd33bd630c7faea8ecc6a452b5e\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "ゲシュペンス島の森の中。",
      "voice": "",
      "command": ""
    },
    {
      "row": 15,
      "speaker": "",
      "text": "探索の合間に水分補給でもしようかと木陰に入ると、\nファングリスさんが無言で何かの準備をしていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "",
      "text": "金属音とともに、背中から器具を展開し始めたと思ったら、\nどこからか白濁した液体を取り出して、",
      "voice": "",
      "command": ""
    },
    {
      "row": 20,
      "speaker": "",
      "text": "背中のポートに注入している。",
      "voice": "",
      "command": ""
    },
    {
      "row": 21,
      "speaker": "主人公",
      "text": "……それ、何をしているんですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 22,
      "speaker": "ファングリス",
      "text": "冷却液ダ。高温地帯の行動後は、必ず排熱処理を行ウ。\n体内の循環装置に異常が出ないよう、\n規定量を注入しているノダ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_001",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "主人公",
      "text": "いえ、\nそれ……どう見ても怪しい液体にしか見えないんですが！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "ファングリス",
      "text": "大丈夫ダ。問題ナイ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_002",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "",
      "text": "ファングリスさんはこちらを見もせず、\n機械の手入れをしている。",
      "voice": "",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "主人公",
      "text": "それに……音がいやらしすぎませんか！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "",
      "text": "機械からは「ニチャァァ……ニチャァァ……」と、\n聞いたこともない音が漏れていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "ファングリス",
      "text": "空気混入による泡立ちダ。\n成分は、冷却用グリス・水分・安定剤。問題はナイ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_003",
      "command": ""
    },
    {
      "row": 33,
      "speaker": "主人公",
      "text": "なるほど、生体メンテナンス。\n理解はできますが……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 35,
      "speaker": "",
      "text": "少し近寄って様子を見ようとしたら、",
      "voice": "",
      "command": ""
    },
    {
      "row": 40,
      "speaker": "",
      "text": "ファングリスさんの手元にあったスイッチに、\n肘がぶつかってしまった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 41,
      "speaker": "ファングリス",
      "text": "あっ……！　そ、それハ――っ！",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_004",
      "command": ""
    },
    {
      "row": 43,
      "speaker": "",
      "text": "ブシュッという派手な機械音とともに、",
      "voice": "",
      "command": ""
    },
    {
      "row": 57,
      "speaker": "",
      "text": "白濁した液体が噴き出した。",
      "voice": "",
      "command": ""
    },
    {
      "row": 60,
      "speaker": "ファングリス",
      "text": "んぷぅっ！？　ふっ、ふぁぁ……！？",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_005",
      "command": ""
    },
    {
      "row": 63,
      "speaker": "",
      "text": "しかも、\n勢いよくファングリスさんの身体に降りかかる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 64,
      "speaker": "ファングリス",
      "text": "ぬっ……身体がぬめぬめになったナ……。\nこれでは作業に支障がデル。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_006",
      "command": ""
    },
    {
      "row": 65,
      "speaker": "主人公",
      "text": "ちょ、それ……大丈夫なんですか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 66,
      "speaker": "ファングリス",
      "text": "熱、逃げぬノダ。全体に広がった冷却液は、\n予期せぬ展開ダガ……想定内だ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_007",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "ファングリス",
      "text": "衣服が濡れても、機能低下は起きナイ。\nイロイロ覗けなくて残念だったな、ショタ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_008",
      "command": ""
    },
    {
      "row": 68,
      "speaker": "主人公",
      "text": "ち、違うんです。",
      "voice": "",
      "command": ""
    },
    {
      "row": 70,
      "speaker": "主人公",
      "text": "そういう反応を見たかったんじゃなくてですね！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 71,
      "speaker": "ファングリス",
      "text": "キャー。ショタサンのえっちー。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_009",
      "command": ""
    },
    {
      "row": 73,
      "speaker": "主人公",
      "text": "そういう反応も望んでません！",
      "voice": "",
      "command": ""
    },
    {
      "row": 74,
      "speaker": "主人公",
      "text": "すみません。タオル持ってますので、\nとりあえず拭かせてください。",
      "voice": "",
      "command": ""
    },
    {
      "row": 77,
      "speaker": "",
      "text": "服の表面を慎重にタオルで拭き取っていく。",
      "voice": "",
      "command": ""
    },
    {
      "row": 81,
      "speaker": "",
      "text": "ぬめりは強く、動かすたびに粘着音が立つ。",
      "voice": "",
      "command": ""
    },
    {
      "row": 83,
      "speaker": "主人公",
      "text": "ああ、せめて音だけでも、\nもうちょっと清潔感が欲しい……ですね。",
      "voice": "",
      "command": ""
    },
    {
      "row": 84,
      "speaker": "ファングリス",
      "text": "……機能性重視ダ。\n拭くのはもういいゾ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_010",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "",
      "text": "拭き終えると、ファングリスさんは無言で器具を折りたたみ、\n背を向けたまま片付けを始める。",
      "voice": "",
      "command": ""
    },
    {
      "row": 88,
      "speaker": "主人公",
      "text": "本当に……冷却液なんですよね……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 89,
      "speaker": "ファングリス",
      "text": "常温保管可能、無毒、無臭。\n成分証明書も提出可能ダ。問題は……見た目と音ダナ。",
      "voice": "ch_10364/R18/10364A0_10364_Nml/10364A0_10364_011",
      "command": ""
    },
    {
      "row": 90,
      "speaker": "",
      "text": "タオルを握ったまま、僕はその場に立ち尽くす。",
      "voice": "",
      "command": ""
    },
    {
      "row": 92,
      "speaker": "",
      "text": "森の風が妙にひんやりとして、",
      "voice": "",
      "command": ""
    },
    {
      "row": 94,
      "speaker": "",
      "text": "拭い切れなかった白濁が<interval=0.4>僕の手の甲に落ちたのだった。",
      "voice": "",
      "command": ""
    }
  ]
}
