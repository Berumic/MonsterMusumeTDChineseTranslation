{
  "scenario_id": "10375a0_nml",
  "asset_path": "assets/advscene/scenarioexcel/character/10375/10375a0_nml.book.asset",
  "cache_bundle": "C:\\mnms_td_r18\\monster_musume_tdx_Data\\Caches\\34b6ae094ee23e28fb0d5c599a5cd3819a364ece57509628a8183988235c2a33\\34b6ae094ee23e28fb0d5c599a5cd381\\__data",
  "rows": [
    {
      "row": 7,
      "speaker": "",
      "text": "その日、溶岩地帯で異常が起きていると聞いた僕は、\n様子を見に訪れていた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 8,
      "speaker": "ニーサ城娘コス",
      "text": "あら、ご主人さまじゃない。\nご機嫌よう♪",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_001",
      "command": ""
    },
    {
      "row": 9,
      "speaker": "主人公",
      "text": "ニーサさん？\nあれ、その格好……。",
      "voice": "",
      "command": ""
    },
    {
      "row": 12,
      "speaker": "ニーサ城娘コス",
      "text": "ふふふっ、どうかしら。\n聞いて驚きなさいっ！\nあたし、異世界から新しい力を得たのよ！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_002",
      "command": ""
    },
    {
      "row": 13,
      "speaker": "",
      "text": "自慢げ",
      "voice": "",
      "command": ""
    },
    {
      "row": 18,
      "speaker": "",
      "text": "に胸を張るニーサさん。\nそして、新しい衣装を見せびらかすように、",
      "voice": "",
      "command": ""
    },
    {
      "row": 23,
      "speaker": "",
      "text": "その場でくるっと１周、ターンしてみせた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 24,
      "speaker": "主人公",
      "text": "なんだか、ご機嫌そうですね？",
      "voice": "",
      "command": ""
    },
    {
      "row": 25,
      "speaker": "ニーサ城娘コス",
      "text": "ええ、とても良い気分！\n言ったでしょう、力を得たって。\nただ服装が変わっただけじゃないのよ。",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_003",
      "command": ""
    },
    {
      "row": 26,
      "speaker": "ニーサ城娘コス",
      "text": "ほら、見てちょうだい。\nこんなこともできるようになったのよ！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_004",
      "command": ""
    },
    {
      "row": 27,
      "speaker": "",
      "text": "ニーサさんがパチンと",
      "voice": "",
      "command": ""
    },
    {
      "row": 31,
      "speaker": "",
      "text": "指を鳴らす。",
      "voice": "",
      "command": ""
    },
    {
      "row": 32,
      "speaker": "",
      "text": "すると、突然目の前に",
      "voice": "",
      "command": ""
    },
    {
      "row": 44,
      "speaker": "",
      "text": "火の玉がぼうっと燃え上がった。",
      "voice": "",
      "command": ""
    },
    {
      "row": 47,
      "speaker": "主人公",
      "text": "わあっ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 48,
      "speaker": "ニーサ城娘コス",
      "text": "ふふふっ、驚き顔も可愛いわね、ご主人さま。\nもちろん、怒った顔の方が、何億倍も素敵だけど。",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_005",
      "command": ""
    },
    {
      "row": 49,
      "speaker": "ニーサ城娘コス",
      "text": "この炎獄の力……あたしでも、ちょっと扱いが難しいから、\nここで練習してたんだけど……そうだ！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_006",
      "command": ""
    },
    {
      "row": 50,
      "speaker": "ニーサ城娘コス",
      "text": "ねえ、ご主人さま。\nせっかくだし、少し練習に付き合ってくれないかしら。",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_007",
      "command": ""
    },
    {
      "row": 52,
      "speaker": "主人公",
      "text": "えっと……僕に何かできることあるんでしょうか？",
      "voice": "",
      "command": ""
    },
    {
      "row": 53,
      "speaker": "ニーサ城娘コス",
      "text": "ええ、もちろんよ。\nふふふふふ……♪",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_008",
      "command": ""
    },
    {
      "row": 55,
      "speaker": "",
      "text": "ニーサさんは不敵に笑うと、",
      "voice": "",
      "command": ""
    },
    {
      "row": 67,
      "speaker": "",
      "text": "僕の周りにたくさんの火の玉を生み出した。",
      "voice": "",
      "command": ""
    },
    {
      "row": 69,
      "speaker": "主人公",
      "text": "熱っ！？\nちょ、ニーサさん！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 70,
      "speaker": "ニーサ城娘コス",
      "text": "ふふふ……ねえ、ご主人さま。\nこ",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_009",
      "command": ""
    },
    {
      "row": 72,
      "speaker": "ニーサ城娘コス",
      "text": "んな昔話を知っているかしら。",
      "voice": "",
      "command": ""
    },
    {
      "row": 84,
      "speaker": "ニーサ城娘コス",
      "text": "むかしむかーし、あるゲシュペンス島に、\nイグニとフリスというモンスター娘が棲んでいました。",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_010",
      "command": ""
    },
    {
      "row": 87,
      "speaker": "主人公",
      "text": "すごく聞き覚えのあるワードばかりなんですけど！？\nそんな昔じゃないですよね、それ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 100,
      "speaker": "ニーサ城娘コス",
      "text": "ある日イグニとフリスは、道を歩くご主人さまを見つけ、\nそのパンツをどちらが脱がせられるか競うことにしました。",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_011",
      "command": ""
    },
    {
      "row": 115,
      "speaker": "ニーサ城娘コス",
      "text": "まずはフリスが冷気を浴びせ、吹き飛ばそうとしましたが、\nご主人さまは身をかがめ、パンツを必死に守ってしまいました。",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_012",
      "command": ""
    },
    {
      "row": 130,
      "speaker": "ニーサ城娘コス",
      "text": "それならばと今度はイグニが熱風を浴びせました。\nすると、なんということでしょう！　その熱にたまらず、\nご主人さまは",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_013",
      "command": ""
    },
    {
      "row": 132,
      "speaker": "ニーサ城娘コス",
      "text": "パンツを脱ぎ捨ててしまったのです！",
      "voice": "",
      "command": ""
    },
    {
      "row": 133,
      "speaker": "主人公",
      "text": "全然身に覚えが無いエピソードなんですけど！？\nていうか、パンツまで脱ぐ状況ってどんなですか……？",
      "voice": "",
      "command": ""
    },
    {
      "row": 143,
      "speaker": "ニーサ城娘コス",
      "text": "重要なのは、パンツの着脱ではないわ。\nここで一番大事なのはね……きっとこの時、\nご主人さまは怒っただろうってことよ！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_014",
      "command": ""
    },
    {
      "row": 145,
      "speaker": "主人公",
      "text": "だから、身に覚えがないですってば！！",
      "voice": "",
      "command": ""
    },
    {
      "row": 146,
      "speaker": "",
      "text": "絶対に創作だ。\nなのに、ニーサさんは聞く耳を持ってくれない。",
      "voice": "",
      "command": ""
    },
    {
      "row": 149,
      "speaker": "ニーサ城娘コス",
      "text": "あたしが、死者をも溶かすといわれる炎で熱してあげれば、\n怒りを通り越し、激おこギンギン棒間違いなしっ！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_015",
      "command": ""
    },
    {
      "row": 151,
      "speaker": "主人公",
      "text": "ギンギン棒ってなんですか！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 152,
      "speaker": "ニーサ城娘コス",
      "text": "というわけで……一気に火力アーップ！！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_016",
      "command": ""
    },
    {
      "row": 154,
      "speaker": "主人公",
      "text": "わああっ！？",
      "voice": "",
      "command": ""
    },
    {
      "row": 155,
      "speaker": "",
      "text": "僕を囲む火の玉が、火力を何倍にも増して燃え上がる。",
      "voice": "",
      "command": ""
    },
    {
      "row": 159,
      "speaker": "主人公",
      "text": "うあぁ…………。",
      "voice": "",
      "command": ""
    },
    {
      "row": 160,
      "speaker": "ニーサ城娘コス",
      "text": "わっ、ご主人さま！？",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_017",
      "command": ""
    },
    {
      "row": 161,
      "speaker": "",
      "text": "凄まじい熱に、意識が吹っ飛びそうになる。\nそんな僕を、",
      "voice": "",
      "command": ""
    },
    {
      "row": 165,
      "speaker": "",
      "text": "ニーサさんが慌てて支えてくれた。",
      "voice": "",
      "command": ""
    },
    {
      "row": 166,
      "speaker": "ニーサ城娘コス",
      "text": "し、しまった……怒る余裕も残らないくらい、\n熱しすぎちゃった……！？\n気絶しちゃったら怒らせるどころじゃない……！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_018",
      "command": ""
    },
    {
      "row": 168,
      "speaker": "ニーサ城娘コス",
      "text": "ご主人さま！？\n目を覚まして、ご主人さまーっ！！",
      "voice": "ch_10375/R18/10375A0_10375_Nml/10375A0_10375_019",
      "command": ""
    },
    {
      "row": 169,
      "speaker": "",
      "text": "僕はニーサさんの本気で焦った声を聞きつつ、\n意識を失っていくのだった……。",
      "voice": "",
      "command": ""
    }
  ]
}
